# --- Server ---
NODE_ENV="development"
APP_NAME="Site ERP"
PORT=3000
SESSION_SECRET="change-this-to-a-long-random-string"

# --- Database (Supabase) ---
# Supabase: Project Settings -> Database -> Connection string (URI).
# Use the "Session" pooler string for a long-running server, e.g.:
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
ERP_DATABASE_URL="postgresql://user:password@host:5432/postgres"
# SSL mode: "auto" (default) enables SSL for hosted DBs (Supabase) and disables
# it for a local Postgres (localhost). Force with "true" or "false".
#   - Supabase / hosted Postgres -> "true" or "auto"
#   - Local Postgres without SSL  -> "false"
PGSSL="auto"

# --- Admin bootstrap (used by: npm run seed) ---
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD="admin123"

# --- Uploads ---
MAX_UPLOAD_MB=5
