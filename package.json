{
  "name": "site-erp",
  "version": "6.4.1",
  "description": "Site ERP: multi-site inventory, procurement (PO->GRN), bills/payments/approvals, vendors — PostgreSQL/Supabase (SQLite for local testing).",
  "main": "src/server.js",
  "scripts": {
    "start": "node --experimental-sqlite --no-warnings=ExperimentalWarning src/server.js",
    "dev": "nodemon --exec \"node --experimental-sqlite --no-warnings=ExperimentalWarning\" src/server.js",
    "migrate": "node --experimental-sqlite --no-warnings=ExperimentalWarning scripts/migrate.js",
    "seed": "node --experimental-sqlite --no-warnings=ExperimentalWarning scripts/seed-admin.js",
    "smoke": "node --experimental-sqlite --no-warnings=ExperimentalWarning scripts/smoke-test.js",
    "verify": "node --experimental-sqlite --no-warnings=ExperimentalWarning scripts/verify.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "bwip-js": "^4.11.4",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "jsbarcode": "^3.12.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
