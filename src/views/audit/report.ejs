<div class="d-flex justify-content-between align-items-center mb-3">
  <div><h2 class="mb-0">Inventory Audit Report — <%= rec.session.name %></h2>
    <div class="text-muted small"><%= rec.session.period || '' %> · Location: <%= rec.session.location || 'All' %> · <span class="badge text-bg-<%= rec.session.status==='open'?'warning':'success' %>"><%= rec.session.status %></span><% if (rec.session.closed_at) { %> · closed <%= new Date(rec.session.closed_at).toLocaleString() %><% } %></div></div>
  <div class="d-flex gap-2"><a class="btn btn-outline-secondary" href="/inventory-audit">All audits</a><a class="btn btn-outline-success" href="/inventory-audit/<%= rec.session.id %>/export.csv">Export CSV</a><button class="btn btn-outline-primary" id="printBtn">Print / PDF</button></div>
</div>

<div class="row g-3 mb-3">
  <div class="col-6 col-lg-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Ledger (book) value</div><div class="metric">₹<%= Number(rec.totals.ledgerValue).toLocaleString('en-IN') %></div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Scanned (physical) value</div><div class="metric">₹<%= Number(rec.totals.scannedValue).toLocaleString('en-IN') %></div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card shadow-sm border-danger"><div class="card-body"><div class="text-muted small">Value of missing inventory</div><div class="metric text-danger">₹<%= Number(rec.totals.missingValue).toLocaleString('en-IN') %></div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card shadow-sm border-warning"><div class="card-body"><div class="text-muted small">Items with discrepancy</div><div class="metric text-warning"><%= rec.totals.discrepItems %> / <%= rec.totals.itemsCounted %></div></div></div></div>
</div>

<div class="card shadow-sm mb-3"><div class="card-header d-flex justify-content-between"><strong>Scanned vs Ledger (inventory report)</strong><span class="small text-muted">Net value difference: ₹<%= Number(rec.totals.netValue).toLocaleString('en-IN') %></span></div><div class="card-body table-responsive">
<% if (!rec.rows.length) { %><p class="text-muted mb-0">Nothing to reconcile.</p><% } else { %>
<table class="table table-sm table-striped align-middle"><thead><tr><th>Item</th><th>Description</th><th class="text-end">Ledger Qty</th><th class="text-end">Scanned Qty</th><th class="text-end">Discrepancy</th><th class="text-end">Avg Cost</th><th class="text-end">Missing Value</th></tr></thead><tbody>
<% rec.rows.forEach(r => { %><tr class="<%= r.discrepancy!==0?'table-warning':'' %>">
  <td><%= r.item_code %></td><td><%= r.description %></td>
  <td class="text-end"><%= r.ledger_qty %></td><td class="text-end"><%= r.scanned_qty %></td>
  <td class="text-end <%= r.discrepancy<0?'text-danger':(r.discrepancy>0?'text-primary':'') %>"><strong><%= r.discrepancy>0?'+':'' %><%= r.discrepancy %></strong></td>
  <td class="text-end">₹<%= Number(r.avg_cost).toFixed(2) %></td>
  <td class="text-end text-danger"><%= r.missing_value>0 ? '₹'+Number(r.missing_value).toLocaleString('en-IN') : '' %></td>
</tr><% }) %>
</tbody><tfoot><tr class="fw-bold"><td colspan="6" class="text-end">Total value of missing inventory</td><td class="text-end text-danger">₹<%= Number(rec.totals.missingValue).toLocaleString('en-IN') %></td></tr></tfoot></table>
<div class="small text-muted mt-2">Discrepancy = scanned (physical) − ledger (book). Negative = shortfall (missing); positive = more found than the book shows. Note: for per-batch items a single scan counts the batch quantity — verify bulk items by physical count where needed.</div>
<% } %></div></div>

<% if (rec.unknownScans && rec.unknownScans.length) { %>
<div class="card shadow-sm"><div class="card-header text-danger"><strong>Unknown codes scanned</strong> (not in the system)</div><div class="card-body table-responsive">
<table class="table table-sm mb-0"><thead><tr><th>Code</th><th>Time</th><th>By</th></tr></thead><tbody>
<% rec.unknownScans.forEach(u => { %><tr><td><code><%= u.scanned_code %></code></td><td><%= new Date(u.scanned_at).toLocaleString() %></td><td><%= u.username || '' %></td></tr><% }) %>
</tbody></table></div></div>
<% } %>
<script nonce="<%= cspNonce %>">document.getElementById('printBtn').addEventListener('click',function(){window.print();});</script>
