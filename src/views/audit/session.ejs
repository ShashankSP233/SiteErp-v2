<div class="d-flex justify-content-between align-items-center mb-3">
  <div><h2 class="mb-0"><%= session.name %> <span class="badge text-bg-warning">open</span></h2><div class="text-muted small">Location: <%= session.location || 'All' %> · started by <%= session.started_by_name || '' %></div></div>
  <div class="d-flex gap-2">
    <a class="btn btn-outline-secondary" href="/inventory-audit">All audits</a>
    <form method="post" action="/inventory-audit/<%= session.id %>/close" onsubmit="return confirm('Close this audit and generate the reconciliation report?')" class="m-0"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-success">Close &amp; Reconcile</button></form>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-5">
    <div class="card shadow-sm"><div class="card-body">
      <label class="form-label"><strong>Scan barcode</strong></label>
      <input id="scanInput" class="form-control form-control-lg" data-scan="enter" data-scan-continuous placeholder="Scan or type a code, press Enter" autocomplete="off" autofocus>
      <div id="scanMsg" class="mt-2 small"></div>
      <div class="d-flex gap-3 mt-3">
        <div>Matched: <span class="badge text-bg-success" id="cMatched"><%= counts.matched || 0 %></span></div>
        <div>Unexpected: <span class="badge text-bg-warning" id="cUnexpected"><%= counts.unexpected || 0 %></span></div>
        <div>Unknown: <span class="badge text-bg-danger" id="cUnknown"><%= counts.unknown || 0 %></span></div>
        <div>Dupes: <span class="badge text-bg-secondary" id="cDuplicate"><%= counts.duplicate || 0 %></span></div>
      </div>
    </div></div>
  </div>
  <div class="col-lg-7"><div class="card shadow-sm"><div class="card-header"><strong>Scans</strong> (latest first)</div>
    <div class="card-body table-responsive" style="max-height:60vh;overflow:auto">
      <table class="table table-sm align-middle mb-0"><thead><tr><th>Time</th><th>Code</th><th>Item</th><th>Result</th></tr></thead>
      <tbody id="scanRows">
      <% scans.forEach(s => { %><tr><td class="small"><%= new Date(s.scanned_at).toLocaleTimeString() %></td><td><code><%= s.scanned_code %></code></td><td><%= s.item_code || '' %></td><td><span class="badge text-bg-<%= s.result==='matched'?'success':(s.result==='unknown'?'danger':(s.result==='duplicate'?'secondary':'warning')) %>"><%= s.result %></span></td></tr><% }) %>
      </tbody></table>
    </div>
  </div></div>
</div>

<script nonce="<%= cspNonce %>">
(function(){
  var input=document.getElementById('scanInput'), rows=document.getElementById('scanRows'), msg=document.getElementById('scanMsg');
  var token='<%= csrfToken %>', sid='<%= session.id %>';
  var badge={matched:'success',unknown:'danger',duplicate:'secondary',unexpected:'warning'};
  function esc(s){var d=document.createElement('div');d.textContent=s==null?'':s;return d.innerHTML;}
  async function scan(code){
    try{
      var res=await fetch('/inventory-audit/'+sid+'/scan',{method:'POST',headers:{'Content-Type':'application/json','x-csrf-token':token},body:JSON.stringify({code:code})});
      var d=await res.json();
      if(!d.ok){ msg.innerHTML='<span class="text-danger">'+esc(d.error)+'</span>'; return; }
      var tr=document.createElement('tr');
      tr.innerHTML='<td class="small">'+new Date().toLocaleTimeString()+'</td><td><code>'+esc(d.code)+'</code></td><td>'+esc(d.item_code||'')+'</td><td><span class="badge text-bg-'+(badge[d.result]||'secondary')+'">'+d.result+'</span></td>';
      rows.insertBefore(tr, rows.firstChild);
      var c=document.getElementById('c'+d.result.charAt(0).toUpperCase()+d.result.slice(1)); if(c) c.textContent=(+c.textContent)+1;
      msg.innerHTML = d.result==='matched' ? '<span class="text-success">✓ '+esc(d.item_code)+' — '+esc(d.description||'')+'</span>'
        : d.result==='unknown' ? '<span class="text-danger">✗ Unknown code (not in system)</span>'
        : d.result==='duplicate' ? '<span class="text-secondary">Already scanned</span>'
        : '<span class="text-warning">Found, but not expected at this location ('+esc(d.location||'?')+')</span>';
    }catch(e){ msg.innerHTML='<span class="text-danger">Network error</span>'; }
  }
  input.addEventListener('keydown',function(e){ if(e.key==='Enter'){ e.preventDefault(); var v=input.value.trim(); input.value=''; if(v) scan(v); }});
  input.focus();
})();
</script>
