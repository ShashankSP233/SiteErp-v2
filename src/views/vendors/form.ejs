<div class="d-flex justify-content-between align-items-center mb-3"><h2 class="mb-0"><%= vendor.id ? 'Edit Vendor' : 'Add Vendor' %></h2><a class="btn btn-outline-secondary" href="/vendors">Back</a></div>
<form method="post" action="<%= vendor.id ? '/vendors/'+vendor.id : '/vendors' %>" class="card shadow-sm"><div class="card-body row g-3">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="col-md-6"><label class="form-label">Name *</label><input name="name" value="<%= vendor.name || '' %>" class="form-control" required></div>
  <div class="col-md-6"><label class="form-label">Contact Person</label><input name="contactName" value="<%= vendor.contact_name || '' %>" class="form-control"></div>
  <div class="col-md-4"><label class="form-label">Mobile</label><input name="mobile" value="<%= vendor.mobile || '' %>" class="form-control"></div>
  <div class="col-md-4"><label class="form-label">Phone</label><input name="phone" value="<%= vendor.phone || '' %>" class="form-control"></div>
  <div class="col-md-4"><label class="form-label">Email</label><input name="email" type="email" value="<%= vendor.email || '' %>" class="form-control"></div>
  <div class="col-md-4"><label class="form-label">GSTIN</label><input name="gstin" value="<%= vendor.gstin || '' %>" class="form-control"></div>
  <div class="col-md-8"><label class="form-label">Address</label><input name="address" value="<%= vendor.address || '' %>" class="form-control"></div>
  <div class="col-12"><label class="form-label">Notes</label><textarea name="notes" class="form-control"><%= vendor.notes || '' %></textarea></div>
  <div class="col-12"><button class="btn btn-primary">Save Vendor</button></div>
</div></form>
