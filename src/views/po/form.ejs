<div class="d-flex justify-content-between align-items-center mb-3"><h2 class="mb-0">New Purchase Order</h2><a class="btn btn-outline-secondary" href="/purchase-orders">Back</a></div>
<form method="post" action="/purchase-orders?_csrf=<%= csrfToken %>" enctype="multipart/form-data" class="card shadow-sm"><div class="card-body">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="row g-3 mb-3">
    <div class="col-md-4"><label class="form-label">Vendor</label><input name="vendor" list="vList" class="form-control" required></div>
    <div class="col-md-3"><label class="form-label">PO Date</label><input name="poDate" type="date" class="form-control"></div>
    <div class="col-md-3"><label class="form-label">Deliver To (site)</label><input name="deliveryTo" list="lList" class="form-control"></div>
    <div class="col-md-2"><label class="form-label">&nbsp;</label><button type="button" class="btn btn-outline-primary w-100" id="addLine">+ Add Line</button></div>
    <div class="col-md-8"><label class="form-label">Notes</label><input name="notes" class="form-control"></div>
    <div class="col-md-4"><label class="form-label">Attachment (image/PDF)</label><input name="attachment" type="file" accept="image/*,.pdf" class="form-control"></div>
  </div>
  <div class="table-responsive"><table class="table table-sm align-middle" id="lines">
    <thead><tr><th style="width:45%">Item</th><th>Quantity</th><th>Rate</th><th>Amount</th><th></th></tr></thead>
    <tbody></tbody>
    <tfoot><tr><th colspan="3" class="text-end">Total</th><th id="grandTotal">0.00</th><th></th></tr></tfoot>
  </table></div>
  <button class="btn btn-primary mt-2">Create & Submit for Approval</button>
</div></form>
<datalist id="vList"><% vendors.forEach(v => { %><option value="<%= v.name %>"></option><% }) %></datalist>
<datalist id="lList"></datalist>
<template id="itemOptions"><% items.forEach(i => { %><option value="<%= i.id %>"><%= i.item_code %> — <%= i.description %></option><% }) %></template>
<script nonce="<%= cspNonce %>">
(function(){
  const tbody=document.querySelector('#lines tbody'), opts=document.getElementById('itemOptions').innerHTML;
  let n=0;
  function recalc(){
    let total=0;
    tbody.querySelectorAll('tr').forEach(tr=>{
      const q=parseFloat(tr.querySelector('[data-q]').value)||0, r=parseFloat(tr.querySelector('[data-r]').value)||0;
      const amt=q*r; tr.querySelector('[data-amt]').textContent=amt.toFixed(2); total+=amt;
    });
    document.getElementById('grandTotal').textContent=total.toFixed(2);
  }
  function addLine(){
    const i=n++; const tr=document.createElement('tr');
    tr.innerHTML='<td><select name="lines['+i+'][itemId]" class="form-select form-select-sm" required><option value="">Select item</option>'+opts+'</select></td>'+
      '<td><input name="lines['+i+'][quantity]" data-q type="number" min="0.01" step="0.01" class="form-control form-control-sm" required></td>'+
      '<td><input name="lines['+i+'][rate]" data-r type="number" min="0" step="0.01" value="0" class="form-control form-control-sm"></td>'+
      '<td data-amt>0.00</td><td><button type="button" class="btn btn-sm btn-outline-danger" data-del>&times;</button></td>';
    tbody.appendChild(tr);
    tr.querySelectorAll('[data-q],[data-r]').forEach(el=>el.addEventListener('input',recalc));
    tr.querySelector('[data-del]').addEventListener('click',()=>{tr.remove();recalc();});
  }
  document.getElementById('addLine').addEventListener('click',addLine);
  addLine();
})();
</script>
