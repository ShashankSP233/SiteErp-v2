<div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="mb-0">Purchase Orders</h2><div class="text-muted small">Page <%= page %> of <%= totalPages %> (<%= total %>)</div></div><a class="btn btn-primary" href="/purchase-orders/new">New PO</a></div>
<div class="card shadow-sm"><div class="card-body table-responsive"><table class="table table-striped data-table align-middle">
<thead><tr><th>PO No</th><th>Date</th><th>Vendor</th><th>Lines</th><th>Value</th><th>Status</th><th></th></tr></thead><tbody>
<% pos.forEach(p => { const sc={submitted:'warning',approved:'info',partially_received:'primary',received:'success',rejected:'danger',cancelled:'secondary'}[p.status]||'secondary'; %>
<tr><td><strong><%= p.po_no %></strong></td><td><%= new Date(p.po_date).toLocaleDateString() %></td><td><%= p.vendor || '' %></td><td><%= p.line_count %></td><td>₹<%= Number(p.po_value).toLocaleString('en-IN') %></td><td><span class="badge text-bg-<%= sc %>"><%= p.status.replace('_',' ') %></span></td><td><a class="btn btn-sm btn-outline-primary" href="/purchase-orders/<%= p.id %>">Open</a></td></tr><% }) %>
</tbody></table></div></div>
<% if (totalPages > 1) { %><nav class="mt-3"><ul class="pagination justify-content-center">
<li class="page-item <%= page<=1?'disabled':'' %>"><a class="page-link" href="/purchase-orders?page=<%= page-1 %>">Previous</a></li>
<li class="page-item disabled"><span class="page-link"><%= page %> / <%= totalPages %></span></li>
<li class="page-item <%= page>=totalPages?'disabled':'' %>"><a class="page-link" href="/purchase-orders?page=<%= page+1 %>">Next</a></li></ul></nav><% } %>
