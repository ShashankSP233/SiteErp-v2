<div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="mb-0"><%= item.item_code %> — <%= item.description %></h2></div><a class="btn btn-outline-secondary" href="/items">Back</a></div>
<div class="card shadow-sm mb-4"><div class="card-header"><strong>Stock by location</strong></div><div class="card-body table-responsive">
<% if (!availability.length) { %><p class="text-muted mb-0">No stock on hand.</p><% } else { %>
<table class="table table-sm mb-0"><thead><tr><th>Location</th><th>Balance</th><th>Brand</th><th>Vendor</th><th>Serial</th><th>Avg Cost</th></tr></thead><tbody>
<% availability.forEach(a => { %><tr><td><%= a.location %></td><td><strong><%= a.balance %></strong></td><td><%= a.brand || '' %></td><td><%= a.vendor || '' %></td><td><%= a.serial_no || '' %></td><td>₹<%= Number(a.cost||0).toFixed(2) %></td></tr><% }) %>
</tbody></table><% } %></div></div>
<div class="card shadow-sm"><div class="card-header"><strong>Movement history</strong></div><div class="card-body table-responsive">
<table class="table table-striped"><thead><tr><th>Date</th><th>Type</th><th>Qty</th><th>Running</th><th>GRN/Issue</th><th>Location</th><th>Cost</th><th>User</th></tr></thead><tbody>
<% entries.forEach(e => { %><tr><td><%= new Date(e.transaction_date).toLocaleString() %></td><td><span class="badge text-bg-secondary"><%= e.transaction_type %></span></td><td><%= e.quantity %></td><td><strong><%= e.running_balance %></strong></td><td><%= e.grn_no || e.issue_order_no || '' %></td><td><%= e.source_location || e.issue_location || '' %></td><td>₹<%= Number(e.cost||0).toFixed(2) %></td><td><%= e.username %></td></tr><% }) %>
</tbody></table></div></div>
