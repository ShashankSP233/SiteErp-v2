<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-1">Inventory Instances</h1>
    <p class="text-muted mb-0">
      Physical inventory currently registered in Site-ERP.
    </p>
  </div>

  <% if (['admin', 'manager', 'operator'].includes(currentUser.role)) { %>
    <a href="/inventory/receive" class="btn btn-primary">
      Add Stock
    </a>
  <% } %>
</div>

<% if (typeof query !== 'undefined' && query.received) { %>
  <div class="alert alert-success">
    Inventory received successfully.
    Instance:
    <strong><%= query.received %></strong>
  </div>
<% } %>

<% if (!instances.length) { %>

  <div class="card">
    <div class="card-body text-center py-5">
      <h5>No inventory instances yet</h5>

      <p class="text-muted mb-3">
        Receive your first physical inventory instance to get started.
      </p>

      <% if (['admin', 'manager', 'operator'].includes(currentUser.role)) { %>
        <a href="/inventory/receive" class="btn btn-primary">
          Add Stock
        </a>
      <% } %>
    </div>
  </div>

<% } else { %>

  <div class="card">
    <div class="card-body p-0">

      <div class="table-responsive">

        <table class="table table-hover mb-0 align-middle">

          <thead class="table-light">
            <tr>
              <th>Instance</th>
              <th>Item</th>
              <th>Brand</th>
              <th>Barcode</th>
              <th>Current</th>
              <th>Allocated</th>
              <th>Available</th>
              <th>Site</th>
              <th>Condition</th>
              <th>Status</th>
              <th>Received</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>

          <tbody>

            <% instances.forEach(instance => { %>

              <tr>

                <!-- Instance -->
                <td>
                  <a
                    href="/inventory/instances/lookup?code=<%= encodeURIComponent(instance.instance_code) %>"
                    class="text-decoration-none"
                    title="View instance details"
                  >
                    <strong><%= instance.instance_code %></strong>
                  </a>
                </td>

                <!-- Item -->
                <td>
                  <div>
                    <strong>
                      <%= instance.item_code %>
                    </strong>
                  </div>

                  <small class="text-muted">
                    <%= instance.item_name %>
                  </small>
                </td>

                <td><%= instance.brand || '—' %></td>

                <!-- Barcode -->
                <td>
                  <code>
                    <%= instance.barcode %>
                  </code>
                </td>

                <!-- Current quantity -->
                <td>
                  <%= Number(instance.current_quantity).toLocaleString() %>
                  <%= instance.unit %>
                </td>

                <!-- Quantity allocated to active issues -->
                <td>
                  <%= Number(instance.issued_quantity || 0).toLocaleString() %>
                  <%= instance.unit %>
                </td>

                <!-- Quantity actually available -->
                <td>
                  <strong>
                    <%= Number(
                      instance.available_quantity ?? instance.current_quantity
                    ).toLocaleString() %>
                    <%= instance.unit %>
                  </strong>
                </td>

                <!-- Site -->
                <td>
                  <% if (instance.site_code) { %>

                    <strong>
                      <%= instance.site_code %>
                    </strong>

                    <br>

                    <small class="text-muted">
                      <%= instance.site_name %>
                    </small>

                  <% } else { %>

                    <span class="text-muted">
                      No site
                    </span>

                  <% } %>
                </td>

                <!-- Condition -->
                <td>

                  <% if (instance.condition === 'GOOD') { %>

                    <span class="badge bg-success">
                      Good
                    </span>

                  <% } else { %>

                    <span class="badge bg-warning text-dark">
                      <%= instance.condition %>
                    </span>

                  <% } %>

                </td>

                <!-- Status -->
                <td>

                  <% if (instance.lifecycle_status === 'ACTIVE') { %>

                    <span class="badge bg-primary">
                      Active
                    </span>

                  <% } else if (instance.lifecycle_status === 'CONSUMED') { %>

                    <span class="badge bg-secondary">
                      Consumed
                    </span>

                  <% } else { %>

                    <span class="badge bg-warning text-dark">
                      <%= instance.lifecycle_status === 'QUARANTINED' ? 'Quarantined' : instance.lifecycle_status %>
                    </span>

                  <% } %>

                </td>

                <!-- Received -->
                <td>
                  <small>
                    <%= new Date(instance.created_at).toLocaleString() %>
                  </small>
                </td>
                
                <td class="text-end">
                  <a
                    href="/inventory/movements?instanceCode=<%= encodeURIComponent(instance.instance_code) %>"
                    class="btn btn-sm btn-outline-secondary"
                  >
                    History
                  </a>
                </td>
                <td class="text-end">

                  <% if (['admin', 'manager'].includes(currentUser.role) &&
                        instance.lifecycle_status === 'ACTIVE') { %>

                    <a
                      href="/inventory/adjustment?instanceCode=<%= encodeURIComponent(instance.instance_code) %>"
                      class="btn btn-sm btn-outline-primary"
                    >
                      Adjust
                    </a>

                  <% } else { %>

                    <span class="text-muted">
                      —
                    </span>

                  <% } %>

                </td>
              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    </div>
  </div>

<% } %>
