<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <div>
    <h1 class="h3 mb-1">Inventory Instances</h1>
    <p class="text-muted mb-0">
      Physical inventory currently registered in Site-ERP.
    </p>
  </div>

  <% if (['admin', 'manager', 'operator'].includes(currentUser.role)) { %>
    <a href="/inventory/receive" class="btn btn-primary">
      Add Stock
    </a>
  <% } %>
</div>

<% if (typeof query !== 'undefined' && query.received) { %>
  <div class="alert alert-success">
    Inventory received successfully.
    Instance:
    <strong><%= query.received %></strong>
  </div>
<% } %>

<form method="get" action="/inventory/instances" class="card mb-3">
  <div class="card-body">
    <div class="row g-2 align-items-end">
      <div class="col-12 col-md-6 col-xl-3"><label for="instanceSearch" class="form-label">Search</label><input id="instanceSearch" class="form-control" type="search" name="search" value="<%= filters.search %>" placeholder="Instance, barcode, item, brand…"></div>
      <div class="col-6 col-md-3 col-xl-2"><label for="instanceItem" class="form-label">Item</label><select id="instanceItem" name="item" class="form-select"><option value="">All items</option><% items.forEach(item => { %><option value="<%= item.id %>" <%= filters.item === String(item.id) ? 'selected' : '' %>><%= item.code %> — <%= item.name %></option><% }) %></select></div>
      <div class="col-6 col-md-3 col-xl-2"><label for="instanceSite" class="form-label">Site</label><select id="instanceSite" name="site" class="form-select"><option value="">All sites</option><option value="none" <%= filters.site === 'none' ? 'selected' : '' %>>No site</option><% sites.forEach(site => { %><option value="<%= site.id %>" <%= filters.site === String(site.id) ? 'selected' : '' %>><%= site.code %> — <%= site.name %></option><% }) %></select></div>
      <div class="col-6 col-md-3 col-xl-1"><label for="instanceStatus" class="form-label">Status</label><select id="instanceStatus" name="status" class="form-select"><option value="">All</option><% ['ACTIVE','CONSUMED','QUARANTINED'].forEach(status => { %><option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status %></option><% }) %></select></div>
      <div class="col-6 col-md-3 col-xl-1"><label for="instanceCondition" class="form-label">Condition</label><select id="instanceCondition" name="condition" class="form-select"><option value="">All</option><% ['GOOD','DAMAGED','NEEDS_REPAIR'].forEach(condition => { %><option value="<%= condition %>" <%= filters.condition === condition ? 'selected' : '' %>><%= condition.replace('_',' ') %></option><% }) %></select></div>
      <div class="col-12 col-md-6 col-xl-2"><label for="instanceSort" class="form-label">Sort by</label><select id="instanceSort" name="sort" class="form-select"><option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest received</option><option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>>Oldest received</option><option value="instance_asc" <%= filters.sort === 'instance_asc' ? 'selected' : '' %>>Instance code A–Z</option><option value="instance_desc" <%= filters.sort === 'instance_desc' ? 'selected' : '' %>>Instance code Z–A</option><option value="item_asc" <%= filters.sort === 'item_asc' ? 'selected' : '' %>>Item code A–Z</option><option value="available_desc" <%= filters.sort === 'available_desc' ? 'selected' : '' %>>Available quantity (high to low)</option></select></div>
      <div class="col-12 col-xl-1 d-flex gap-2"><button class="btn btn-primary flex-grow-1" type="submit">Apply</button><a class="btn btn-outline-secondary" href="/inventory/instances" aria-label="Clear filters">Clear</a></div>
    </div>
  </div>
</form>

<% if (!instances.length) { %>

  <div class="card">
    <div class="card-body text-center py-5">
      <h5><%= totalInstances ? 'No matching instances' : 'No inventory instances yet' %></h5>

      <p class="text-muted mb-3">
        <%= totalInstances ? 'Try changing or clearing your filters.' : 'Receive your first physical inventory instance to get started.' %>
      </p>

      <% if (!totalInstances && ['admin', 'manager', 'operator'].includes(currentUser.role)) { %>
        <a href="/inventory/receive" class="btn btn-primary">
          Add Stock
        </a>
      <% } %>
    </div>
  </div>

<% } else { %>

  <div class="card">
    <div class="card-header bg-white"><span class="text-muted small">Showing <%= instances.length %> of <%= totalInstances %> physical instance<%= totalInstances === 1 ? '' : 's' %></span></div>

    <div class="d-none d-xl-block">
      <table class="table table-hover mb-0 align-middle inventory-instance-table">
        <colgroup><col style="width:19%"><col style="width:21%"><col style="width:13%"><col style="width:15%"><col style="width:12%"><col style="width:10%"><col style="width:10%"></colgroup>
        <thead class="table-light"><tr><th>Instance</th><th>Item</th><th>Barcode</th><th>Stock</th><th>Site</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
          <% instances.forEach(instance => { const status = String(instance.lifecycle_status || '').toUpperCase(); %>
            <tr>
              <td class="text-break"><a href="/inventory/instances/lookup?code=<%= encodeURIComponent(instance.instance_code) %>" class="text-decoration-none"><strong><%= instance.instance_code %></strong></a></td>
              <td class="text-break"><strong class="d-block"><%= instance.item_code %></strong><small class="text-muted"><%= instance.item_name %></small></td>
              <td class="text-break"><code><%= instance.barcode || '—' %></code></td>
              <td class="small"><div>Current: <%= Number(instance.current_quantity).toLocaleString() %> <%= instance.unit %></div><div>Allocated: <%= Number(instance.issued_quantity || 0).toLocaleString() %> <%= instance.unit %></div><strong>Available: <%= Number(instance.available_quantity ?? instance.current_quantity).toLocaleString() %> <%= instance.unit %></strong></td>
              <td class="text-break"><% if (instance.site_code) { %><strong><%= instance.site_code %></strong><small class="d-block text-muted"><%= instance.site_name %></small><% } else { %><span class="text-muted">No site</span><% } %></td>
              <td><span class="badge <%= status === 'ACTIVE' ? 'bg-primary' : status === 'CONSUMED' ? 'bg-secondary' : 'bg-warning text-dark' %>"><%= status === 'QUARANTINED' ? 'Quarantined' : (status || 'Unknown') %></span><span class="badge ms-1 <%= instance.condition === 'GOOD' ? 'bg-success' : 'bg-warning text-dark' %>"><%= instance.condition === 'GOOD' ? 'Good' : instance.condition %></span></td>
              <td><div class="d-flex flex-wrap gap-1"><a href="/inventory/movements?instanceCode=<%= encodeURIComponent(instance.instance_code) %>" class="btn btn-sm btn-outline-secondary">History</a><% if (['admin', 'manager'].includes(currentUser.role) && instance.lifecycle_status === 'ACTIVE') { %><a href="/inventory/adjustment?instanceCode=<%= encodeURIComponent(instance.instance_code) %>" class="btn btn-sm btn-outline-primary">Adjust</a><% } %></div></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="d-xl-none">
      <% instances.forEach(instance => { const status = String(instance.lifecycle_status || '').toUpperCase(); %>
        <article class="border-top p-3 inventory-instance-card">
          <div class="d-flex justify-content-between align-items-start gap-2"><div class="min-w-0"><a href="/inventory/instances/lookup?code=<%= encodeURIComponent(instance.instance_code) %>" class="text-decoration-none text-break"><strong><%= instance.instance_code %></strong></a><div class="mt-1"><strong class="d-block text-break"><%= instance.item_code %></strong><small class="text-muted"><%= instance.item_name %></small></div></div><span class="badge flex-shrink-0 <%= status === 'ACTIVE' ? 'bg-primary' : status === 'CONSUMED' ? 'bg-secondary' : 'bg-warning text-dark' %>"><%= status === 'QUARANTINED' ? 'Quarantined' : (status || 'Unknown') %></span></div>
          <div class="row g-2 mt-2 small"><div class="col-4"><span class="text-muted d-block">Current</span><%= Number(instance.current_quantity).toLocaleString() %> <%= instance.unit %></div><div class="col-4"><span class="text-muted d-block">Allocated</span><%= Number(instance.issued_quantity || 0).toLocaleString() %> <%= instance.unit %></div><div class="col-4"><span class="text-muted d-block">Available</span><strong><%= Number(instance.available_quantity ?? instance.current_quantity).toLocaleString() %> <%= instance.unit %></strong></div></div>
          <div class="mt-2 small"><span class="text-muted">Site:</span> <%= instance.site_code ? `${instance.site_code} — ${instance.site_name}` : 'No site' %><span class="badge ms-1 <%= instance.condition === 'GOOD' ? 'bg-success' : 'bg-warning text-dark' %>"><%= instance.condition === 'GOOD' ? 'Good' : instance.condition %></span></div>
          <details class="mt-2 small"><summary class="text-primary">More details</summary><div class="mt-2 text-break"><span class="text-muted">Barcode:</span> <code><%= instance.barcode || '—' %></code></div><div><span class="text-muted">Brand:</span> <%= instance.brand || '—' %></div><div><span class="text-muted">Received:</span> <%= new Date(instance.created_at).toLocaleString() %></div></details>
          <div class="d-flex flex-wrap gap-2 mt-3"><a href="/inventory/movements?instanceCode=<%= encodeURIComponent(instance.instance_code) %>" class="btn btn-sm btn-outline-secondary">Movement History</a><% if (['admin', 'manager'].includes(currentUser.role) && instance.lifecycle_status === 'ACTIVE') { %><a href="/inventory/adjustment?instanceCode=<%= encodeURIComponent(instance.instance_code) %>" class="btn btn-sm btn-outline-primary">Adjust</a><% } %></div>
        </article>
      <% }) %>
    </div>
  </div>

  <style>
    .inventory-instance-table { width:100%; table-layout:fixed; }
    .inventory-instance-table th, .inventory-instance-table td { overflow-wrap:anywhere; }
    .inventory-instance-card { min-width:0; overflow-wrap:anywhere; }
    .inventory-instance-card .min-w-0 { min-width:0; }
    .inventory-instance-card:first-of-type { border-top:0 !important; }
  </style>

<% } %>
