  <div class="d-flex justify-content-between align-items-start mb-4">

    <div>

      <h1 class="h3 mb-1">
        <%= transfer.transfer_number %>
      </h1>

      <p class="mb-1">

        <strong>
          <%= transfer.from_site_code %>
        </strong>

        →
        
        <strong>
          <%= transfer.to_site_code %>
        </strong>

      </p>

      <span class="text-muted">
        <%= transfer.from_site_name %>
        →
        <%= transfer.to_site_name %>
      </span>

    </div>


    <div class="d-flex gap-2">
      <button
        type="button"
        class="btn btn-primary"
        id="print-stn-button"
      >
        Print STN
      </button>

      <a
        href="/inventory/transfers/<%= transfer.id %>/barcodes"
        class="btn btn-outline-primary <%= items.some(item => item.barcode) ? '' : 'disabled' %>"
        target="_blank"
        rel="noopener"
        <%= items.some(item => item.barcode) ? '' : 'aria-disabled="true"' %>
      >
        Print Item Barcodes
      </a>

      <a
        href="/inventory/transfers"
        class="btn btn-outline-secondary"
      >
        All Transfers
      </a>

      <% if (
        ['IN_TRANSIT', 'PARTIALLY_RECEIVED'].includes(transfer.status) &&
        items.some(item => item.status === 'IN_TRANSIT')
      ) { %>
        <form
          method="POST"
          action="/inventory/stock-receive/<%= transfer.id %>/close"
          onsubmit="return confirm('Close this Stock Inward and mark all remaining unreceived items as MIA?');"
        >
          <input
            type="hidden"
            name="_csrf"
            value="<%= csrfToken %>"
          >

          <button
            type="submit"
            class="btn btn-danger"
          >
            Close Inward
          </button>
        </form>
      <% } %>
    </div>

  </div>


  <div class="row g-3 mb-4">

    <div class="col-md-3">

      <div class="card">

        <div class="card-body">

          <small class="text-muted">
            Status
          </small>

          <div class="mt-2">

            <% if (transfer.status === 'DRAFT') { %>

              <span class="badge bg-secondary fs-6">
                Draft
              </span>

            <% } else if (transfer.status === 'IN_TRANSIT') { %>

              <span class="badge bg-warning text-dark fs-6">
                In Transit
              </span>

            <% } else if (
              transfer.status === 'PARTIALLY_RECEIVED'
            ) { %>

              <span class="badge bg-warning text-dark fs-6">
                Partially Received
              </span>

            <% } else if (
              transfer.status === 'RECEIVED'
            ) { %>

              <span class="badge bg-success fs-6">
                Received
              </span>

            <% } else { %>

              <span class="badge bg-secondary fs-6">
                <%= transfer.status %>
              </span>

            <% } %>

          </div>

        </div>

      </div>

    </div>


    <div class="col-md-3">

      <div class="card">

        <div class="card-body">

          <small class="text-muted">
            Instances
          </small>

          <h4 class="mb-0 mt-2">
            <%= items.length %>
          </h4>

        </div>

      </div>

    </div>


    <div class="col-md-3">

      <div class="card">

        <div class="card-body">

          <small class="text-muted">
            Received
          </small>

          <h4 class="mb-0 mt-2 text-success">
            <%= items.filter(
              item => item.status === 'RECEIVED'
            ).length %>
          </h4>

        </div>

      </div>

    </div>


    <div class="col-md-3">

      <div class="card">

        <div class="card-body">

          <small class="text-muted">
            Still In Transit
          </small>

          <h4 class="mb-0 mt-2 text-warning">
            <%= items.filter(
              item => item.status === 'IN_TRANSIT'
            ).length %>
          </h4>

        </div>

      </div>

    </div>

  </div>


  <% if (transfer.notes) { %>

    <div class="alert alert-secondary">

      <strong>
        Transfer Note:
      </strong>

      <%= transfer.notes %>

    </div>

  <% } %>


  <% if (transfer.status === 'DRAFT') { %>

    <!-- ======================================================
        ADD PHYSICAL INSTANCE
        ====================================================== -->

    <div class="card mb-4">

      <div class="card-header">
        <strong>Scan Inventory for Dispatch</strong>
      </div>

      <div class="card-body">

        <form
          method="post"
          action="/inventory/transfers/<%= transfer.id %>/items"
        >

          <input
            type="hidden"
            name="_csrf"
            value="<%= csrfToken %>"
          >


          <div class="row g-3 align-items-end">

            <div class="col-md-8">

              <label
                class="form-label"
                for="instanceCode"
              >
                Instance Code / Barcode
              </label>

              <input
                type="text"
                class="form-control form-control-lg"
                id="instanceCode"
                name="instanceCode"
                data-scan="submit"
                autocomplete="off"
                autofocus
                placeholder="Scan barcode or enter instance code"
                required
              >

              <div class="form-text">
                A scanner gun can be used directly because it behaves
                like a keyboard.
              </div>

            </div>


            <div class="col-md-4">

              <button
                type="submit"
                class="btn btn-primary btn-lg w-100"
              >
                Add Instance
              </button>

            </div>

          </div>

        </form>

      </div>

    </div>


    <!-- ======================================================
        DISPATCH
        ====================================================== -->

    <div class="card mb-4">

      <div class="card-header d-flex justify-content-between">

        <strong>
          Instances to Dispatch
        </strong>

        <span class="text-muted">
          <%= items.length %> instance(s)
        </span>

      </div>


      <div class="card-body p-0">

        <% if (!items.length) { %>

          <div class="p-4 text-center text-muted">
            No physical instances have been scanned yet.
          </div>

        <% } else { %>

          <div class="table-responsive">

            <table class="table table-hover mb-0">

              <thead class="table-light">

                <tr>
                  <th>Instance</th>
                  <th>Item</th>
                  <th>Quantity</th>
                  <th>Status</th>
                </tr>

              </thead>

              <tbody>

                <% items.forEach(item => { %>

                  <tr>

                    <td>
                      <strong>
                        <%= item.instance_code %>
                      </strong>

                      <br>

                      <small class="text-muted">
                        <%= item.barcode %>
                      </small>
                    </td>

                    <td>
                      <strong>
                        <%= item.item_code %>
                      </strong>

                      <br>

                      <small class="text-muted">
                        <%= item.item_name %>
                      </small>
                    </td>

                    <td>
                      <%= Number(
                        item.quantity
                      ).toLocaleString() %>
                      <%= item.unit %>
                    </td>

                    <td>
                      <span class="badge bg-secondary">
                        Ready
                      </span>
                    </td>

                  </tr>

                <% }) %>

              </tbody>

            </table>

          </div>


          <div class="p-3 border-top">

            <form
              method="post"
              action="/inventory/transfers/<%= transfer.id %>/dispatch"
              onsubmit="return confirm('Dispatch this transfer? All scanned instances will move to IN TRANSIT.');"
            >

              <input
                type="hidden"
                name="_csrf"
                value="<%= csrfToken %>"
              >

              <button
                type="submit"
                class="btn btn-warning"
                <%= items.length ? '' : 'disabled' %>
              >
                Dispatch Transfer
              </button>

            </form>

          </div>

        <% } %>

      </div>

    </div>


  <% } else { %>


    <!-- ======================================================
        RECEIVING / STOCK INWARD
        ====================================================== -->

  <div class="card mb-4">

    <div class="card-header">
      <strong>Stock Inward</strong>
    </div>

    <div class="card-body">

      <p class="text-muted">
        Scan each physical inventory instance that has actually
        arrived at this site. You can also type the instance code
        or barcode manually.
      </p>


      <form
        method="post"
        action="/inventory/transfers/<%= transfer.id %>/receive-scan"
      >

        <input
          type="hidden"
          name="_csrf"
          value="<%= csrfToken %>"
        >


        <div class="row g-3 align-items-end">

          <div class="col-md-9">

            <label
              class="form-label"
              for="scannedCode"
            >
              Instance Code / Barcode
            </label>

            <input
              type="text"
              class="form-control form-control-lg"
              id="scannedCode"
              name="scannedCode"
              data-scan="submit"
              autocomplete="off"
              autofocus
              placeholder="Scan barcode or enter instance code"
              required
            >

            <div class="form-text">
              Scan one physical item at a time. The system will
              verify that the scanned instance belongs to this STN.
            </div>

          </div>


          <div class="col-md-3">

            <button
              type="submit"
              class="btn btn-success btn-lg w-100"
            >
              Receive Item
            </button>

          </div>

        </div>

      </form>

    </div>

  </div>


  <div class="card">

    <div class="card-header d-flex justify-content-between">

      <strong>
        Transfer Items
      </strong>

      <span class="text-muted">
        Scan each item physically received
      </span>

    </div>


    <div class="card-body p-0">

      <div class="table-responsive">

        <table class="table table-hover mb-0 align-middle">

          <thead class="table-light">

            <tr>
              <th>Instance</th>
              <th>Item</th>
              <th>Quantity</th>
              <th>Status</th>
              <th>Received At</th>
            </tr>

          </thead>


          <tbody>

            <% items.forEach(item => { %>

              <tr>

                <td>

                  <strong>
                    <%= item.instance_code %>
                  </strong>

                  <br>

                  <small class="text-muted">
                    <%= item.barcode %>
                  </small>

                </td>


                <td>

                  <strong>
                    <%= item.item_code %>
                  </strong>

                  <br>

                  <small class="text-muted">
                    <%= item.item_name %>
                  </small>

                </td>


                <td>

                  <%= Number(
                    item.quantity
                  ).toLocaleString() %>

                  <%= item.unit %>

                </td>


                <td>

                  <% if (item.status === 'RECEIVED') { %>

                    <span class="badge bg-success">
                      Received
                    </span>

                  <% } else { %>

                    <span class="badge bg-warning text-dark">
                      In Transit
                    </span>

                  <% } %>

                </td>


                <td>

                  <% if (item.received_at) { %>

                    <small>
                      <%= new Date(
                        item.received_at
                      ).toLocaleString() %>
                    </small>

                  <% } else { %>

                    —

                  <% } %>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    </div>

  </div>
  <% } %>

  <style>
    #stn-print-document { display: none; }
    @page { size: A4 landscape; margin: 10mm; }
    @media print {
      body * { visibility: hidden !important; }
      #stn-print-document,
      #stn-print-document * { visibility: visible !important; }
      #stn-print-document {
        display: block !important;
        position: absolute;
        inset: 0;
        width: 100%;
        color: #17202a;
        background: #fff;
        font: 10px Arial, sans-serif;
      }
      #stn-print-document header { display: flex; justify-content: space-between; border-bottom: 2px solid #263b55; padding-bottom: 10px; margin-bottom: 12px; }
      #stn-print-document h1 { margin: 0 0 4px; font-size: 20px; }
      #stn-print-document .stn-number { font-size: 16px; font-weight: bold; }
      #stn-print-document .meta { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px 18px; margin-bottom: 14px; }
      #stn-print-document .label { display: block; color: #596674; font-size: 8px; text-transform: uppercase; margin-bottom: 3px; }
      #stn-print-document table { width: 100%; table-layout: fixed; border-collapse: collapse; font-size: 8px; }
      #stn-print-document th, #stn-print-document td { border: 1px solid #aeb8c2; padding: 5px 4px; text-align: left; vertical-align: top; overflow-wrap: anywhere; word-break: break-word; }
      #stn-print-document th { background: #e9eef3 !important; print-color-adjust: exact; }
      #stn-print-document th:nth-child(1), #stn-print-document td:nth-child(1) { width: 3%; text-align: center; }
      #stn-print-document th:nth-child(2), #stn-print-document td:nth-child(2), #stn-print-document th:nth-child(3), #stn-print-document td:nth-child(3) { width: 13%; }
      #stn-print-document th:nth-child(4), #stn-print-document td:nth-child(4) { width: 10%; }
      #stn-print-document th:nth-child(5), #stn-print-document td:nth-child(5) { width: 21%; }
      #stn-print-document th:nth-child(6), #stn-print-document td:nth-child(6) { width: 9%; }
      #stn-print-document th:nth-child(7), #stn-print-document td:nth-child(7) { width: 10%; }
      #stn-print-document th:nth-child(8), #stn-print-document td:nth-child(8) { width: 21%; }
      #stn-print-document thead { display: table-header-group; }
      #stn-print-document tr { break-inside: avoid; page-break-inside: avoid; }
      #stn-print-document h2 { font-size: 10px; margin: 16px 0 5px; text-transform: uppercase; }
      #stn-print-document .notes { border: 1px solid #aeb8c2; padding: 7px; white-space: pre-wrap; min-height: 28px; }
      #stn-print-document .signatures { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; margin-top: 38px; }
      #stn-print-document .sign { border-top: 1px solid #263b55; padding-top: 5px; }
    }
  </style>

  <section id="stn-print-document" aria-hidden="true">
    <header>
      <div><h1>Stock Transfer Note</h1><div>Site to site inventory movement</div></div>
      <div class="stn-number"><%= transfer.transfer_number %></div>
    </header>
    <div class="meta">
      <div><span class="label">From site</span><strong><%= transfer.from_site_code %> - <%= transfer.from_site_name %></strong></div>
      <div><span class="label">To site</span><strong><%= transfer.to_site_code %> - <%= transfer.to_site_name %></strong></div>
      <div><span class="label">Status</span><%= transfer.status.replaceAll('_', ' ') %></div>
      <div><span class="label">Created</span><%= new Date(transfer.created_at).toLocaleString() %></div>
      <div><span class="label">Prepared by</span><%= transfer.created_by_name || '-' %></div>
      <div><span class="label">Dispatched</span><%= transfer.dispatched_at ? new Date(transfer.dispatched_at).toLocaleString() : '-' %><%= transfer.dispatched_by_name ? ` by ${transfer.dispatched_by_name}` : '' %></div>
    </div>
    <table>
      <thead><tr><th>#</th><th>Instance code</th><th>Barcode</th><th>Item code</th><th>Description</th><th>Quantity</th><th>Status</th><th>Received at</th></tr></thead>
      <tbody>
        <% if (items.length) { %>
          <% items.forEach((item, index) => { %>
            <tr>
              <td><%= index + 1 %></td><td><%= item.instance_code %></td><td><%= item.barcode || '-' %></td>
              <td><%= item.item_code %></td><td><%= item.item_name %></td>
              <td><%= Number(item.quantity).toLocaleString() %> <%= item.unit %></td>
              <td><%= item.status.replaceAll('_', ' ') %></td>
              <td><% if (item.received_at) { %><%= transfer.to_site_code %> - <%= transfer.to_site_name %><br><%= new Date(item.received_at).toLocaleString() %><% } else { %>-<% } %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="8">No items have been added to this transfer.</td></tr>
        <% } %>
      </tbody>
    </table>
    <h2>Transfer notes</h2><div class="notes"><%= transfer.notes || '-' %></div>
    <div class="signatures"><div class="sign">Released by (name, signature and date)</div><div class="sign">Received by (name, signature and date)</div></div>
  </section>

  <script nonce="<%= cspNonce %>">
    document.getElementById('print-stn-button').addEventListener('click', function () {
      window.print();
    });
  </script>
