<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4"><div><div class="text-muted small">Inventory / Issue Batch / Scanning</div><h1 class="h3 mb-1">BATCH-<%= String(batch.id).padStart(6,'0') %></h1><p class="text-muted mb-0"><%= batch.recipient_type %> — <%= batch.recipient_reference %><% if (batch.site_code) { %> · From <%= batch.site_code %><% } %></p></div><div class="d-flex gap-2"><a href="/inventory/issues" class="btn btn-outline-secondary">Issue Batches</a><% if (batch.issues.length) { %><a href="/inventory/returns/<%= batch.id %>" class="btn btn-outline-primary">Receive This Batch</a><% } %></div></div>

<% if (error) { %><div class="alert alert-danger alert-dismissible fade show" role="alert"><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div><% } %>
<% if (success) { %><div class="alert alert-success alert-dismissible fade show" role="status"><%= success %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div><% } %>

<section class="card shadow-sm mb-4"><div class="card-header bg-white py-3"><h2 class="h5 mb-0"><%= batch.finalized_at ? 'Issue batch confirmed' : 'Scan instances to issue' %></h2></div><div class="card-body"><% if (batch.finalized_at) { %><div class="alert alert-success mb-0">This batch was issued on <%= new Date(batch.finalized_at).toLocaleString() %>. Its items can no longer be changed.</div><% } else { %><form method="post" action="/inventory/issue-batches/<%= batch.id %>/scan" class="row g-3 align-items-end"><% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %><div class="col-md-10"><label class="form-label" for="batch-instance-code">Instance code or barcode</label><input class="form-control form-control-lg" id="batch-instance-code" name="instanceCode" data-scan="submit" autocomplete="off" autofocus required placeholder="Scan or enter any item instance code"></div><div class="col-md-2 d-grid"><button class="btn btn-primary btn-lg">Add to List</button></div></form><div class="form-text mt-2">Each scan adds an item to the pending list. Remove any item before confirming the issue.</div><% } %></div></section>

<% if (!batch.finalized_at) { %><section class="card shadow-sm mb-4"><div class="card-header bg-white py-3 d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">Pending issue list</h2><span class="badge text-bg-secondary"><%= batch.stagedInstances.length %> item(s)</span></div><% if (!batch.stagedInstances.length) { %><div class="card-body text-center text-muted">Scan an item instance to add it here. Nothing is issued until you confirm below.</div><% } else { %><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Item / Instance</th><th>Quantity</th><th>Kit</th><th></th></tr></thead><tbody><% batch.stagedInstances.forEach(item => { %><tr><td><strong><%= item.item_code %> — <%= item.item_name %></strong><div><code><%= item.instance_code %></code></div></td><td><%= item.current_quantity %> <%= item.unit || '' %></td><td><%= item.kit_code || '—' %></td><td><form method="post" action="/inventory/issue-batches/<%= batch.id %>/remove"><% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %><input type="hidden" name="instanceId" value="<%= item.instance_id %>"><button class="btn btn-sm btn-outline-danger">Remove</button></form></td></tr><% }) %></tbody></table></div><% } %><div class="card-footer bg-white d-flex justify-content-end"><form method="post" action="/inventory/issue-batches/<%= batch.id %>/finalize"><% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %><button class="btn btn-primary" <%= batch.stagedInstances.length ? '' : 'disabled' %>>Issue <%= batch.stagedInstances.length %> item(s)</button></form></div></section><% } %>

<% if (batch.kits.length) { %><section class="card shadow-sm mb-4"><div class="card-header bg-white py-3"><h2 class="h5 mb-0">Selected Kits — scan every member</h2></div><div class="list-group list-group-flush"><% batch.kits.forEach(kit => { const count = batch.finalized_at ? kit.items.filter(item => item.issue_status).length : batch.stagedInstances.filter(item => kit.items.some(member => member.instance_code === item.instance_code)).length; %><div class="list-group-item"><div class="d-flex justify-content-between"><strong><%= kit.kit_code %> — <%= kit.name %></strong><span class="badge <%= count === kit.items.length ? 'text-bg-success' : 'text-bg-warning' %>"><%= count %> / <%= kit.items.length %> <%= batch.finalized_at ? 'issued' : 'scanned' %></span></div><ul class="small mb-0 mt-2"><% kit.items.forEach(item => { %><li><%= item.item_code %> / <%= item.instance_code %> — <%= batch.finalized_at ? (item.issue_status || 'not issued') : (batch.stagedInstances.some(staged => staged.instance_code === item.instance_code) ? 'pending issue' : 'not scanned') %></li><% }) %></ul></div><% }) %></div></section><% } %>

<section class="card shadow-sm"><div class="card-header bg-white py-3 d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">Items in this batch</h2><span class="text-muted small"><%= batch.issues.length %> item(s)</span></div><% if (!batch.issues.length) { %><div class="card-body text-center text-muted">No instances have been scanned into this batch yet.</div><% } else { %><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Issue</th><th>Item / Instance</th><th>Quantity</th><th>Kit</th><th>Status</th></tr></thead><tbody><% batch.issues.forEach(issue => { %><tr><td><%= issue.issue_number %></td><td><strong><%= issue.item_code %> — <%= issue.item_name %></strong><div><code><%= issue.instance_code %></code></div></td><td><%= issue.issued_quantity %> <%= issue.unit || '' %></td><td><%= issue.kit_code || '—' %></td><td><span class="badge <%= issue.status === 'OPEN' || issue.status === 'PARTIALLY_CONSUMED' ? 'text-bg-primary' : 'text-bg-secondary' %>"><%= issue.status %></span></td></tr><% }) %></tbody></table></div><% } %></section>
