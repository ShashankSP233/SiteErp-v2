<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4"><div><div class="text-muted small">Inventory / Issue Batch / Scanning</div><h1 class="h3 mb-1">BATCH-<%= String(batch.id).padStart(6,'0') %></h1><p class="text-muted mb-0"><%= batch.recipient_type %> — <%= batch.recipient_reference %><% if (batch.site_code) { %> · From <%= batch.site_code %><% } %></p></div><div class="d-flex gap-2"><a href="/inventory/issues" class="btn btn-outline-secondary">Issue Batches</a><% if (batch.issues.length) { %><a href="/inventory/returns/<%= batch.id %>" class="btn btn-outline-primary">Receive This Batch</a><% } %></div></div>

<% if (error) { %><div class="alert alert-danger alert-dismissible fade show" role="alert"><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div><% } %>
<% if (success) { %><div class="alert alert-success alert-dismissible fade show" role="status"><%= success %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div><% } %>

<section class="card shadow-sm mb-4"><div class="card-header bg-white py-3"><h2 class="h5 mb-0">Scan any physical instance to issue</h2></div><div class="card-body"><% if (batch.status !== 'OPEN') { %><div class="alert alert-info mb-0">This batch has started receiving and no longer accepts additional items.</div><% } else { %><form method="post" action="/inventory/issue-batches/<%= batch.id %>/scan" class="row g-3 align-items-end"><% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %><div class="col-md-10"><label class="form-label" for="batch-instance-code">Instance code or barcode</label><input class="form-control form-control-lg" id="batch-instance-code" name="instanceCode" data-scan="submit" autocomplete="off" autofocus required placeholder="Scan or enter any item instance code"></div><div class="col-md-2 d-grid"><button class="btn btn-primary btn-lg">Add to Batch</button></div></form><div class="form-text mt-2">Scan regular item instances one at a time. Each successful scan creates its own issue record under this batch. For a kit, add the kit when creating the batch and scan every member individually.</div><% } %></div></section>

<% if (batch.kits.length) { %><section class="card shadow-sm mb-4"><div class="card-header bg-white py-3"><h2 class="h5 mb-0">Selected Kits — scan every member</h2></div><div class="list-group list-group-flush"><% batch.kits.forEach(kit => { const issued = kit.items.filter(item => item.issue_status); %><div class="list-group-item"><div class="d-flex justify-content-between"><strong><%= kit.kit_code %> — <%= kit.name %></strong><span class="badge <%= issued.length === kit.items.length ? 'text-bg-success' : 'text-bg-warning' %>"><%= issued.length %> / <%= kit.items.length %> issued</span></div><ul class="small mb-0 mt-2"><% kit.items.forEach(item => { %><li><%= item.item_code %> / <%= item.instance_code %> — <%= item.issue_status || 'not scanned' %></li><% }) %></ul></div><% }) %></div></section><% } %>

<section class="card shadow-sm"><div class="card-header bg-white py-3 d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">Items in this batch</h2><span class="text-muted small"><%= batch.issues.length %> item(s)</span></div><% if (!batch.issues.length) { %><div class="card-body text-center text-muted">No instances have been scanned into this batch yet.</div><% } else { %><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Issue</th><th>Item / Instance</th><th>Quantity</th><th>Kit</th><th>Status</th></tr></thead><tbody><% batch.issues.forEach(issue => { %><tr><td><%= issue.issue_number %></td><td><strong><%= issue.item_code %> — <%= issue.item_name %></strong><div><code><%= issue.instance_code %></code></div></td><td><%= issue.issued_quantity %> <%= issue.unit || '' %></td><td><%= issue.kit_code || '—' %></td><td><span class="badge <%= issue.status === 'OPEN' || issue.status === 'PARTIALLY_CONSUMED' ? 'text-bg-primary' : 'text-bg-secondary' %>"><%= issue.status %></span></td></tr><% }) %></tbody></table></div><% } %></section>
