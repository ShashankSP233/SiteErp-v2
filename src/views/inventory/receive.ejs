<%
  const submittedLines = Array.isArray(form?.lines) && form.lines.length ? form.lines : [{}];
  const selectedSiteId = form?.siteId || '';
%>

<div class="receive-page">
<div class="receive-page-heading d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
  <div>
    <div class="receive-eyebrow">INVENTORY · STOCK INTAKE</div>
    <h1 class="h3 mb-1">Add Stock</h1>
    <p class="text-muted mb-0">Register physical items, verify their labels, then add them to the selected site.</p>
  </div>
  <a href="/inventory/instances" class="btn btn-outline-secondary">View Inventory</a>
</div>

<div class="receive-steps mb-4" aria-label="Add stock steps">
  <div class="receive-step active"><span>1</span><div><strong>Receipt details</strong><small>Choose the destination site</small></div></div>
  <div class="receive-step"><span>2</span><div><strong>Items and quantities</strong><small>Enter items and traceability info</small></div></div>
  <div class="receive-step"><span>3</span><div><strong>Print and scan</strong><small>Verify each physical barcode</small></div></div>
</div>

<% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>

<% if (Array.isArray(pendingReceipts) && pendingReceipts.length) { %>
  <div class="card border-warning shadow-sm mb-4">
    <div class="card-header bg-white py-3"><h2 class="h5 mb-0">Unfinished Add Stock receipts</h2></div>
    <div class="list-group list-group-flush">
      <% pendingReceipts.forEach(receipt => { %>
        <div class="list-group-item d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 py-3">
          <div>
            <div class="fw-semibold">Receipt #<%= receipt.id %> · <%= receipt.site_code %> — <%= receipt.site_name %></div>
            <div class="small text-muted"><%= receipt.item_type_count %> item type(s) · <%= receipt.scanned_count %> of <%= receipt.label_count %> labels scanned · Started <%= new Date(receipt.created_at).toLocaleString() %></div>
            <div class="small text-muted">Its barcode numbers are reserved. Resume this receipt to continue scanning the same labels instead of creating another batch.</div>
          </div>
          <a href="/inventory/receive/<%= receipt.id %>/labels#scanner" class="btn btn-outline-primary flex-shrink-0">Resume receipt</a>
        </div>
      <% }) %>
    </div>
  </div>
<% } %>

<form method="POST" action="/inventory/receive" id="add-stock-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="card receive-card shadow-sm mb-4">
    <div class="card-header bg-white py-3"><h2 class="h5 mb-0">Where is this stock going?</h2><div class="small text-muted mt-1">Set the site and add a reference if you have one.</div></div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-6">
          <label for="siteId" class="form-label fw-semibold">Receiving site</label>
          <select class="form-select" id="siteId" name="siteId" required>
            <option value="">Select site...</option>
            <% sites.forEach(site => { %><option value="<%= site.site_id %>" <%= String(selectedSiteId) === String(site.site_id) ? 'selected' : '' %>><%= site.code %> — <%= site.name %></option><% }) %>
          </select>
        </div>
        <div class="col-md-6">
          <label for="reason" class="form-label fw-semibold">Reason / reference <span class="text-muted fw-normal">(optional)</span></label>
          <input type="text" class="form-control" id="reason" name="reason" value="<%= form?.reason || '' %>" maxlength="255" placeholder="e.g. Initial stock receipt">
        </div>
      </div>
    </div>
  </div>

  <div class="card receive-card shadow-sm">
    <div class="card-header bg-white py-3 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
      <div><h2 class="h5 mb-1">Items to add</h2><p class="text-muted small mb-0">Each physical unit gets its own barcode. Add one row per item type.</p></div>
      <button type="button" class="btn btn-outline-primary" id="add-stock-line">＋ Add item row</button>
    </div>
    <div class="card-body" id="stock-lines">
      <% submittedLines.forEach((line, index) => { %>
        <section class="stock-line border rounded p-3 p-lg-4 mb-3" data-index="<%= index %>">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="h6 mb-0">Item <span class="stock-line-number"><%= index + 1 %></span></h3>
            <button type="button" class="btn btn-sm btn-outline-danger remove-stock-line <%= index === 0 ? 'd-none' : '' %>">Remove</button>
          </div>
          <div class="row g-3 align-items-start">
            <div class="col-lg-7">
              <label class="form-label fw-semibold">Item master</label>
              <select class="form-select stock-item" name="lines[<%= index %>][itemMasterId]" required>
                <option value="">Select item...</option>
                <% itemMasters.forEach(item => { %>
                  <option value="<%= item.id %>" data-physical-unit="<%= item.unit || '' %>" data-instance-quantity="<%= item.instance_quantity ?? '' %>" data-quantity-unit="<%= item.instance_quantity_unit || '' %>" <%= String(line.itemMasterId || '') === String(item.id) ? 'selected' : '' %>><%= item.item_code %> — <%= item.name %></option>
                <% }) %>
              </select>
              <div class="item-instance-info small text-muted mt-2">Choose an item to see its configured quantity per physical unit.</div>
            </div>
            <div class="col-lg-5">
              <label class="form-label fw-semibold">Number of physical instances</label>
              <input type="number" class="form-control" name="lines[<%= index %>][quantity]" min="1" step="1" value="<%= line.quantity || '' %>" required>
              <div class="form-text">For example, 4 barrels creates four individually barcoded instances.</div>
            </div>
          </div>
          <details class="traceability-details mt-3">
            <summary>Brand and traceability details <span class="text-muted">Optional</span></summary>
            <div class="row g-3 mt-1">
              <div class="col-md-6 col-xl-4"><label class="form-label">Brand</label><input class="form-control" name="lines[<%= index %>][brand]" maxlength="100" value="<%= line.brand || '' %>" placeholder="e.g. Shell"></div>
              <div class="col-md-6 col-xl-4"><label class="form-label">Batch number</label><input class="form-control" name="lines[<%= index %>][batchNumber]" maxlength="100" value="<%= line.batchNumber || '' %>"></div>
              <div class="col-md-6 col-xl-4"><label class="form-label">Serial number</label><input class="form-control" name="lines[<%= index %>][serialNumber]" maxlength="100" value="<%= line.serialNumber || '' %>" placeholder="Use for one physical instance only"></div>
              <div class="col-md-6 col-xl-4"><label class="form-label">Manufacture date</label><input type="date" class="form-control" name="lines[<%= index %>][manufactureDate]" value="<%= line.manufactureDate || '' %>"></div>
              <div class="col-md-6 col-xl-4"><label class="form-label">Expiry date</label><input type="date" class="form-control" name="lines[<%= index %>][expiryDate]" value="<%= line.expiryDate || '' %>"></div>
            </div>
          </details>
        </section>
      <% }) %>
      <% if (!itemMasters.length) { %><div class="alert alert-warning">No active instance-tracked item masters are available.</div><% } %>
    </div>
    <div class="card-footer bg-white d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 p-3">
      <div class="small text-muted">Stock is added only after labels are printed and each barcode is scanned.</div>
      <div class="d-flex gap-2">
        <a href="/inventory/instances" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary" <%= !itemMasters.length ? 'disabled' : '' %>>Continue to Barcode Labels</button>
      </div>
    </div>
  </div>
</form>

<template id="stock-line-template">
  <section class="stock-line border rounded p-3 p-lg-4 mb-3" data-index="__INDEX__">
    <div class="d-flex justify-content-between align-items-center mb-3"><h3 class="h6 mb-0">Item <span class="stock-line-number"></span></h3><button type="button" class="btn btn-sm btn-outline-danger remove-stock-line">Remove</button></div>
    <div class="row g-3 align-items-start">
      <div class="col-lg-7"><label class="form-label fw-semibold">Item master</label><select class="form-select stock-item" name="lines[__INDEX__][itemMasterId]" required><option value="">Select item...</option><% itemMasters.forEach(item => { %><option value="<%= item.id %>" data-physical-unit="<%= item.unit || '' %>" data-instance-quantity="<%= item.instance_quantity ?? '' %>" data-quantity-unit="<%= item.instance_quantity_unit || '' %>"><%= item.item_code %> — <%= item.name %></option><% }) %></select><div class="item-instance-info small text-muted mt-2">Choose an item to see its configured quantity per physical unit.</div></div>
      <div class="col-lg-5"><label class="form-label fw-semibold">Number of physical instances</label><input type="number" class="form-control" name="lines[__INDEX__][quantity]" min="1" step="1" required><div class="form-text">Each physical unit receives its own barcode.</div></div>
    </div>
    <details class="traceability-details mt-3"><summary>Brand and traceability details <span class="text-muted">Optional</span></summary><div class="row g-3 mt-1">
      <div class="col-md-6 col-xl-4"><label class="form-label">Brand</label><input class="form-control" name="lines[__INDEX__][brand]" maxlength="100"></div>
      <div class="col-md-6 col-xl-4"><label class="form-label">Batch number</label><input class="form-control" name="lines[__INDEX__][batchNumber]" maxlength="100"></div>
      <div class="col-md-6 col-xl-4"><label class="form-label">Serial number</label><input class="form-control" name="lines[__INDEX__][serialNumber]" maxlength="100" placeholder="Use for one physical instance only"></div>
      <div class="col-md-6 col-xl-4"><label class="form-label">Manufacture date</label><input type="date" class="form-control" name="lines[__INDEX__][manufactureDate]"></div>
      <div class="col-md-6 col-xl-4"><label class="form-label">Expiry date</label><input type="date" class="form-control" name="lines[__INDEX__][expiryDate]"></div>
    </div></details>
  </section>
</template>
</div>

<script nonce="<%= cspNonce %>">
  (() => {
    const list = document.getElementById('stock-lines');
    const template = document.getElementById('stock-line-template');
    const addButton = document.getElementById('add-stock-line');

    function refreshRows() {
      const rows = [...list.querySelectorAll('.stock-line')];
      rows.forEach((row, index) => {
        row.querySelector('.stock-line-number').textContent = String(index + 1);
        row.querySelector('.remove-stock-line').classList.toggle('d-none', rows.length === 1);
        row.querySelectorAll('[name]').forEach(field => {
          field.name = field.name.replace(/lines\[\d+\]/, `lines[${index}]`);
        });
      });
    }

    function updateItemInfo(select) {
      const option = select.selectedOptions[0];
      const output = select.closest('.stock-line').querySelector('.item-instance-info');
      if (!option?.value) {
        output.textContent = 'Choose an item to see its configured quantity per physical unit.';
        return;
      }
      output.textContent = `${option.dataset.instanceQuantity || '—'} ${option.dataset.quantityUnit || ''} per ${option.dataset.physicalUnit || 'instance'}`;
    }

    addButton.addEventListener('click', () => {
      const index = list.querySelectorAll('.stock-line').length;
      const html = template.innerHTML.replaceAll('__INDEX__', String(index));
      list.insertAdjacentHTML('beforeend', html);
      refreshRows();
      list.querySelector('.stock-line:last-child .stock-item')?.focus();
    });

    list.addEventListener('click', event => {
      const button = event.target.closest('.remove-stock-line');
      if (button && list.querySelectorAll('.stock-line').length > 1) {
        button.closest('.stock-line').remove();
        refreshRows();
      }
    });
    list.addEventListener('change', event => {
      if (event.target.matches('.stock-item')) updateItemInfo(event.target);
    });
    list.querySelectorAll('.stock-item').forEach(updateItemInfo);
    refreshRows();
  })();
</script>
