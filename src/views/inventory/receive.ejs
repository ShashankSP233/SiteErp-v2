<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-1">Receive Inventory</h1>
    <p class="text-muted mb-0">
      Create a physical inventory instance and record its receipt.
    </p>
  </div>

  <a href="/inventory/instances" class="btn btn-outline-secondary">
    View Inventory
  </a>
</div>

<% if (error) { %>
  <div class="alert alert-danger">
    <%= error %>
  </div>
<% } %>

<div class="card">
  <div class="card-header">
    <strong>New Inventory Instance</strong>
  </div>

  <div class="card-body">
    <form method="POST" action="/inventory/receive">

      <input
        type="hidden"
        name="_csrf"
        value="<%= csrfToken %>"
      >

      <div class="row g-3">

        <div class="col-md-6">
          <label for="itemMasterId" class="form-label">
            Item
          </label>

          <select
            class="form-select"
            id="itemMasterId"
            name="itemMasterId"
            required
          >
            <option value="">Select item...</option>

            <% itemMasters.forEach(item => { %>
              <option
                value="<%= item.id %>"
                <%= String(form.itemMasterId || '') === String(item.id) ? 'selected' : '' %>
              >
                <%= item.item_code %> — <%= item.name %>
              </option>
            <% }) %>
          </select>

          <% if (!itemMasters.length) { %>
            <div class="form-text text-warning">
              No instance-tracked active items are available.
            </div>
          <% } %>
        </div>

        <div class="col-md-3">
          <label for="quantity" class="form-label">
            Quantity
          </label>

          <input
            type="number"
            class="form-control"
            id="quantity"
            name="quantity"
            min="0.001"
            step="0.001"
            value="<%= form.quantity || '' %>"
            required
          >

          <div class="form-text">
            Quantity of this physical instance.
          </div>
        </div>

        <div class="col-md-3">
          <label for="siteId" class="form-label">
            Site
          </label>

          <select
            class="form-select"
            id="siteId"
            name="siteId"
            required
          >
            <option value="">Select site...</option>

            <% sites.forEach(site => { %>
              <option
                value="<%= site.site_id %>"
                <%= String(form.siteId || '') === String(site.site_id) ? 'selected' : '' %>
              >
                <%= site.code %> — <%= site.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-6">
          <label for="batchNumber" class="form-label">
            Batch Number
            <span class="text-muted">(optional)</span>
          </label>

          <input
            type="text"
            class="form-control"
            id="batchNumber"
            name="batchNumber"
            value="<%= form.batchNumber || '' %>"
            maxlength="100"
          >
        </div>

        <div class="col-md-6">
          <label for="serialNumber" class="form-label">
            Serial Number
            <span class="text-muted">(optional)</span>
          </label>

          <input
            type="text"
            class="form-control"
            id="serialNumber"
            name="serialNumber"
            value="<%= form.serialNumber || '' %>"
            maxlength="100"
          >
        </div>

        <div class="col-md-6">
          <label for="manufactureDate" class="form-label">
            Manufacture Date
            <span class="text-muted">(optional)</span>
          </label>

          <input
            type="date"
            class="form-control"
            id="manufactureDate"
            name="manufactureDate"
            value="<%= form.manufactureDate || '' %>"
          >
        </div>

        <div class="col-md-6">
          <label for="expiryDate" class="form-label">
            Expiry Date
            <span class="text-muted">(optional)</span>
          </label>

          <input
            type="date"
            class="form-control"
            id="expiryDate"
            name="expiryDate"
            value="<%= form.expiryDate || '' %>"
          >
        </div>

        <div class="col-12">
          <label for="reason" class="form-label">
            Reason / Reference
            <span class="text-muted">(optional)</span>
          </label>

          <input
            type="text"
            class="form-control"
            id="reason"
            name="reason"
            value="<%= form.reason || '' %>"
            maxlength="255"
            placeholder="e.g. Initial stock receipt"
          >
        </div>

      </div>

      <hr class="my-4">

      <div class="d-flex justify-content-end gap-2">
        <a href="/inventory/instances" class="btn btn-secondary">
          Cancel
        </a>

        <button
          type="submit"
          class="btn btn-primary"
          <%= !itemMasters.length ? 'disabled' : '' %>
        >
          Receive Inventory
        </button>
      </div>

    </form>
  </div>
</div>