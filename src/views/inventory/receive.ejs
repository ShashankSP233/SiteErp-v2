<%
  const selectedItem = (itemMasters || []).find(
    item => String(item.id) === String(form.itemMasterId || '')
  );
%>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
  <div>
    <h1 class="h3 mb-1">Receive Inventory</h1>
    <p class="text-muted mb-0">
      Create physical inventory instances in a site.
    </p>
  </div>

  <a href="/inventory/instances" class="btn btn-outline-secondary">
    View Inventory
  </a>
</div>



<% if (error) { %>
  <div class="alert alert-danger" role="alert"><%= error %></div>
<% } %>

<div class="card shadow-sm">
  <div class="card-header bg-white py-3">
    <h2 class="h5 mb-0">Receive Physical Inventory</h2>
  </div>

  <div class="card-body">
    <form method="POST" action="/inventory/receive">

      <input
        type="hidden"
        name="_csrf"
        value="<%= csrfToken %>"
      >

      <div class="row g-3">

        <div class="col-12 col-md-6">
          <label for="itemMasterId" class="form-label">
            Item
          </label>

          <select
            class="form-select"
            id="itemMasterId"
            name="itemMasterId"
            required
          >
            <option value="">Select item...</option>

            <% itemMasters.forEach(item => { %>
              <option
                value="<%= item.id %>"
                data-physical-unit="<%= item.unit || '' %>"
                data-instance-quantity="<%= item.instance_quantity ?? '' %>"
                data-quantity-unit="<%= item.instance_quantity_unit || '' %>"
                <%= String(form.itemMasterId || '') === String(item.id) ? 'selected' : '' %>
              >
                <%= item.item_code %> — <%= item.name %>
              </option>
            <% }) %>
          </select>

          <% if (!itemMasters.length) { %>
            <div class="form-text text-warning">
              No instance-tracked active items are available.
            </div>
          <% } %>

          <div
            id="selectedItemInfo"
            class="alert alert-info mt-3 mb-0 <%= selectedItem ? '' : 'd-none' %>"
          >
            <div class="fw-semibold mb-2">Selected item contents</div>
            <div class="row g-2 small">
              <div class="col-sm-4">
                <span class="d-block text-muted">Physical Unit</span>
                <strong id="physicalUnit"><%= selectedItem?.unit || '—' %></strong>
              </div>
              <div class="col-sm-4">
                <span class="d-block text-muted">Quantity per Instance</span>
                <strong id="instanceQuantity"><%= selectedItem?.instance_quantity ?? '—' %> <%= selectedItem?.instance_quantity_unit || '' %></strong>
              </div>
              <div class="col-sm-4">
                <span class="d-block text-muted">Quantity Unit</span>
                <strong id="quantityUnit"><%= selectedItem?.instance_quantity_unit || '—' %></strong>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-3">
          <label for="quantity" class="form-label">
            Number of Physical Instances
          </label>

          <input
            type="number"
            class="form-control"
            id="quantity"
            name="quantity"
            min="1"
            step="1"
            value="<%= form.quantity || '' %>"
            required
          >

          <div class="form-text">
             Enter the number of physical units/containers being received.
            Each physical instance will be created with the selected item's configured quantity.
            Example: 5 BARREL creates 5 instances.
          </div>
        </div>

        <div class="col-md-3">
          <label for="siteId" class="form-label">
            Site
          </label>

          <select
            class="form-select"
            id="siteId"
            name="siteId"
            required
          >
            <option value="">Select site...</option>

            <% sites.forEach(site => { %>
              <option
                value="<%= site.site_id %>"
                <%= String(form.siteId || '') === String(site.site_id) ? 'selected' : '' %>
              >
                <%= site.code %> — <%= site.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="col-12">
          <label for="reason" class="form-label">
            Reason / Reference
            <span class="text-muted">(optional)</span>
          </label>

          <input
            type="text"
            class="form-control"
            id="reason"
            name="reason"
            value="<%= form.reason || '' %>"
            maxlength="255"
            placeholder="e.g. Initial stock receipt"
          >
        </div>

        <div class="col-12">
          <button
            type="button"
            class="btn btn-outline-secondary"
            data-bs-toggle="collapse"
            data-bs-target="#traceabilityFields"
            aria-expanded="false"
            aria-controls="traceabilityFields"
          >
            Advanced / Traceability
          </button>
          <div class="form-text">
            Optional details for batch, serial, manufacturing, or expiry information.
          </div>

          <div class="collapse mt-3" id="traceabilityFields">
            <div class="border rounded p-3 bg-light">
              <p class="small text-muted mb-3">
                These fields are optional and can be used when the physical stock carries batch, serial, manufacturing, or expiry information.
              </p>

              <div class="row g-3">
                <div class="col-md-6">
                  <label for="batchNumber" class="form-label">
                    Batch Number <span class="text-muted">(optional)</span>
                  </label>
                  <input
                    type="text"
                    class="form-control"
                    id="batchNumber"
                    name="batchNumber"
                    value="<%= form.batchNumber || '' %>"
                    maxlength="100"
                  >
                </div>

                <div class="col-md-6">
                  <label for="serialNumber" class="form-label">
                    Serial Number <span class="text-muted">(optional)</span>
                  </label>
                  <input
                    type="text"
                    class="form-control"
                    id="serialNumber"
                    name="serialNumber"
                    value="<%= form.serialNumber || '' %>"
                    maxlength="100"
                  >
                </div>

                <div class="col-md-6">
                  <label for="manufactureDate" class="form-label">
                    Manufacture Date <span class="text-muted">(optional)</span>
                  </label>
                  <input
                    type="date"
                    class="form-control"
                    id="manufactureDate"
                    name="manufactureDate"
                    value="<%= form.manufactureDate || '' %>"
                  >
                </div>

                <div class="col-md-6">
                  <label for="expiryDate" class="form-label">
                    Expiry Date <span class="text-muted">(optional)</span>
                  </label>
                  <input
                    type="date"
                    class="form-control"
                    id="expiryDate"
                    name="expiryDate"
                    value="<%= form.expiryDate || '' %>"
                  >
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>

      <hr class="my-4">

      <div class="d-flex justify-content-end gap-2">
        <a href="/inventory/instances" class="btn btn-secondary">
          Cancel
        </a>

        <button
          type="submit"
          class="btn btn-primary"
          <%= !itemMasters.length ? 'disabled' : '' %>
        >
          Receive Inventory
        </button>
      </div>

    </form>
  </div>
</div>

<script nonce="<%= cspNonce %>">
  (() => {
    const itemSelect = document.getElementById('itemMasterId');
    const itemInfo = document.getElementById('selectedItemInfo');
    const physicalUnit = document.getElementById('physicalUnit');
    const instanceQuantity = document.getElementById('instanceQuantity');
    const quantityUnit = document.getElementById('quantityUnit');

    itemSelect?.addEventListener('change', () => {
      const option = itemSelect.selectedOptions[0];

      if (!option || !option.value) {
        itemInfo?.classList.add('d-none');
        return;
      }

      const physicalUnitValue = option.dataset.physicalUnit || '—';
      const instanceQuantityValue = option.dataset.instanceQuantity || '—';
      const quantityUnitValue = option.dataset.quantityUnit || '';

      physicalUnit.textContent = physicalUnitValue;
      instanceQuantity.textContent = `${instanceQuantityValue} ${quantityUnitValue}`.trim();
      quantityUnit.textContent = quantityUnitValue || '—';
      itemInfo?.classList.remove('d-none');
    });
  })();
</script>