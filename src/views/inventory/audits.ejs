<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-1">Inventory Audits</h1>
    <p class="text-muted mb-0">
      Physical stock counts for inventory instances at each site.
    </p>
  </div>
</div>

<% if (['admin', 'manager'].includes(currentUser.role)) { %>
  <div class="card mb-4">
    <div class="card-header">
      <strong>Start Inventory Audit</strong>
    </div>

    <div class="card-body">
      <form method="post" action="/inventory/audits">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label" for="name">Audit Name *</label>
            <input
              id="name"
              name="name"
              class="form-control"
              placeholder="e.g. September Monthly Audit — Site A"
              required
            >
          </div>

          <div class="col-md-3">
            <label class="form-label" for="siteId">Site *</label>
            <select id="siteId" name="siteId" class="form-select" required>
              <option value="">Select site</option>
              <% sites.forEach(site => { %>
                <option value="<%= site.id %>">
                  <%= site.code %> — <%= site.name %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="col-md-3">
            <label class="form-label" for="auditType">Audit Type *</label>
            <select id="auditType" name="auditType" class="form-select" required>
              <% auditTypes.forEach(type => { %>
                <option value="<%= type %>">
                  <%= type.replaceAll('_', ' ') %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="col-md-2 d-flex align-items-end">
            <button class="btn btn-primary w-100">
              Start Audit
            </button>
          </div>
        </div>

        <div class="mt-3">
          <label class="form-label" for="notes">Notes</label>
          <textarea
            id="notes"
            name="notes"
            class="form-control"
            rows="2"
            placeholder="Optional audit notes"
          ></textarea>
        </div>
      </form>
    </div>
  </div>
<% } %>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <strong>Audit History</strong>
    <span class="text-muted small">
      <%= audits.length %> audit(s)
    </span>
  </div>

  <div class="card-body p-0">
    <% if (!audits.length) { %>
      <div class="p-4 text-center text-muted">
        No inventory audits have been created yet.
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
          <thead class="table-light">
            <tr>
              <th>Audit</th>
              <th>Site</th>
              <th>Type</th>
              <th>Status</th>
              <th>Count</th>
              <th>Started</th>
              <th>By</th>
              <th></th>
            </tr>
          </thead>

          <tbody>
            <% audits.forEach(audit => { %>
              <tr>
                <td>
                  <strong><%= audit.name %></strong>
                  <br>
                  <small class="text-muted">#<%= audit.id %></small>
                </td>

                <td>
                  <strong><%= audit.site_code %></strong>
                  <br>
                  <small class="text-muted"><%= audit.site_name %></small>
                </td>

                <td>
                  <%= audit.audit_type.replaceAll('_', ' ') %>
                </td>

                <td>
                  <% if (audit.status === 'IN_PROGRESS') { %>
                    <span class="badge bg-warning text-dark">In Progress</span>
                  <% } else if (audit.status === 'COMPLETED') { %>
                    <span class="badge bg-success">Completed</span>
                  <% } else if (audit.status === 'RECHECK_REQUIRED') { %>
                    <span class="badge bg-danger">Recheck Required</span>
                  <% } else { %>
                    <span class="badge bg-secondary"><%= audit.status %></span>
                  <% } %>
                </td>

                <td>
                  <strong><%= Number(audit.matched_count || 0) %></strong>
                  matched
                  <br>
                  <small class="text-muted">
                    <%= Number(audit.not_counted_count || 0) %> not counted ·
                    <%= Number(audit.missing_count || 0) %> missing ·
                    <%= Number(audit.unexpected_count || 0) %> unexpected
                  </small>
                </td>

                <td>
                  <small><%= new Date(audit.started_at).toLocaleString() %></small>
                </td>

                <td>
                  <%= audit.started_by_name || '—' %>
                </td>

                <td class="text-end">
                  <a
                    href="/inventory/audits/<%= audit.id %>"
                    class="btn btn-sm btn-outline-primary"
                  >
                    Open
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
