<div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="mb-0">Transaction Ledger</h2><div class="text-muted small">Page <%= page %> of <%= totalPages %> (<%= total %> entries)</div></div><a class="btn btn-primary" href="/transactions/new">Record</a></div>
<div class="card shadow-sm"><div class="card-body table-responsive"><table class="table table-striped align-middle">
<thead><tr><th>Date</th><th>Item</th><th>Type</th><th>Qty</th><th>GRN</th><th>Issue</th><th>Location</th><th>Vendor</th><th>Cost</th><th>File</th><th>User</th></tr></thead><tbody>
<% transactions.forEach(t => { %><tr><td><%= new Date(t.transaction_date).toLocaleDateString() %></td><td><%= t.item_code %> — <%= t.description %></td><td><span class="badge text-bg-secondary"><%= t.transaction_type %></span></td><td><%= t.quantity %></td><td><%= t.grn_no || '' %></td><td><%= t.issue_order_no || '' %></td><td><%= t.source_location || t.issue_location || '' %></td><td><%= t.vendor || '' %></td><td>₹<%= Number(t.cost||0).toFixed(2) %></td><td><% if (t.image_path) { %><a href="<%= t.image_path %>" target="_blank" rel="noopener">View</a><% } %></td><td><%= t.username %></td></tr><% }) %>
</tbody></table></div></div>
<% if (totalPages > 1) { %><nav class="mt-3"><ul class="pagination justify-content-center">
<li class="page-item <%= page<=1?'disabled':'' %>"><a class="page-link" href="/transactions?page=<%= page-1 %>">Previous</a></li>
<li class="page-item disabled"><span class="page-link"><%= page %> / <%= totalPages %></span></li>
<li class="page-item <%= page>=totalPages?'disabled':'' %>"><a class="page-link" href="/transactions?page=<%= page+1 %>">Next</a></li>
</ul></nav><% } %>
