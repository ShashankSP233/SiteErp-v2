<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4"><div><div class="text-muted small">Inventory / Receive Returns / Batch</div><h1 class="h3 mb-1">BATCH-<%= String(batch.id).padStart(6,'0') %></h1><p class="text-muted mb-0"><%= batch.recipient_type %> — <%= batch.recipient_reference || '—' %><% if (batch.site_code) { %> · Return to <%= batch.site_code %><% } %></p></div><a href="/inventory/returns" class="btn btn-outline-secondary">Choose Another Batch</a></div>

<% if (batch.status === 'RETURNED') { %><div class="alert alert-success">All returnable items in this batch have been received.</div><% } else { %><section class="card shadow-sm mb-4"><div class="card-header bg-white py-3"><h2 class="h5 mb-0">Scan an instance from this batch</h2></div><div class="card-body"><form method="post" action="/inventory/returns/<%= batch.id %>/scan" class="row g-3 align-items-end"><% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %><div class="col-md-9"><label class="form-label fw-semibold" for="receive-instance">Instance code or barcode</label><input class="form-control form-control-lg" id="receive-instance" name="instanceCode" data-scan="submit" autocomplete="off" autofocus required placeholder="Scan returned item"></div><div class="col-md-2"><label class="form-label" for="receive-note">Note (optional)</label><input class="form-control" id="receive-note" name="reason" maxlength="500"></div><div class="col-md-1 d-grid"><button class="btn btn-primary btn-lg">Receive</button></div></form><div class="form-text mt-2">Only items issued in this batch are accepted. Scanning an item records its return immediately. Kit items remain pending until every instance in that kit has been scanned.</div></div></section><% } %>

<% if (batch.kits.length) { %><section class="card shadow-sm mb-4"><div class="card-header bg-white py-3"><h2 class="h5 mb-0">Kit Return Progress</h2></div><div class="list-group list-group-flush"><% batch.kits.forEach(kit => { const returned = kit.items.filter(item => item.issue_status === 'RETURNED').length; const pending = kit.items.filter(item => item.issue_id && batch.returnScannedIds.has(Number(item.issue_id))).length; %><div class="list-group-item"><div class="d-flex justify-content-between"><strong><%= kit.kit_code %> — <%= kit.name %></strong><span class="badge <%= returned === kit.items.length ? 'text-bg-success' : 'text-bg-warning' %>"><%= returned === kit.items.length ? 'Returned' : `${pending} / ${kit.items.length} scanned` %></span></div><div class="small text-muted mt-1">All instances must be scanned before this kit is accepted.</div><ul class="small mb-0 mt-2"><% kit.items.forEach(item => { %><li><%= item.item_code %> / <%= item.instance_code %> — <%= item.issue_status === 'RETURNED' ? 'returned' : batch.returnScannedIds.has(Number(item.issue_id)) ? 'scanned; waiting for the rest of the kit' : item.issue_status || 'not issued' %></li><% }) %></ul></div><% }) %></div></section><% } %>

<section class="card shadow-sm"><div class="card-header bg-white py-3 d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">Batch Items</h2><span class="text-muted small"><%= batch.issues.filter(issue => issue.status === 'RETURNED').length %> / <%= batch.issues.filter(issue => issue.status !== 'CLOSED').length %> returnable items returned</span></div><% if (!batch.issues.length) { %><div class="card-body text-center text-muted">No items have been issued in this batch.</div><% } else { %><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Item / Instance</th><th>Issue</th><th>Kit</th><th>Remaining</th><th>Status</th></tr></thead><tbody><% batch.issues.forEach(issue => { %><tr><td><strong><%= issue.item_code %> — <%= issue.item_name %></strong><div><code><%= issue.instance_code %></code></div></td><td><%= issue.issue_number %></td><td><%= issue.kit_code || '—' %></td><td><%= issue.remaining_quantity %> <%= issue.unit || '' %></td><td><span class="badge <%= issue.status === 'RETURNED' ? 'text-bg-success' : issue.status === 'OPEN' || issue.status === 'PARTIALLY_CONSUMED' ? 'text-bg-primary' : 'text-bg-secondary' %>"><%= issue.status %></span></td></tr><% }) %></tbody></table></div><% } %></section>
