<div class="container-fluid py-4">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-1">Transfer Register</h1>
      <p class="text-muted mb-0">
        View and filter stock transfers across accessible sites.
      </p>
    </div>

    <a
      href="/inventory/transfers/new"
      class="btn btn-primary"
    >
      New Transfer
    </a>
  </div>

  <!-- ============================================================
       FILTERS
       ============================================================ -->

  <div class="card shadow-sm mb-4">
    <div class="card-body">

      <form
        method="GET"
        action="/inventory/transfer-register"
      >

        <div class="row g-3">

          <!-- Transfer Number -->
          <div class="col-md-3">
            <label class="form-label">
              Transfer Number
            </label>

            <input
              type="text"
              name="transferNumber"
              class="form-control"
              value="<%= filters.transferNumber %>"
              placeholder="e.g. STN-0001"
            >
          </div>

          <!-- From Site -->
          <div class="col-md-2">
            <label class="form-label">
              From Site ID
            </label>

            <input
              type="text"
              name="fromSiteId"
              class="form-control"
              value="<%= filters.fromSiteId %>"
              placeholder="Site ID"
            >
          </div>

          <!-- To Site -->
          <div class="col-md-2">
            <label class="form-label">
              To Site ID
            </label>

            <input
              type="text"
              name="toSiteId"
              class="form-control"
              value="<%= filters.toSiteId %>"
              placeholder="Site ID"
            >
          </div>

          <!-- Status -->
          <div class="col-md-2">
            <label class="form-label">
              Status
            </label>

            <select
              name="status"
              class="form-select"
            >
              <option value="">All Statuses</option>

              <option
                value="DRAFT"
                <%= filters.status === 'DRAFT' ? 'selected' : '' %>
              >
                Draft
              </option>

              <option
                value="IN_TRANSIT"
                <%= filters.status === 'IN_TRANSIT' ? 'selected' : '' %>
              >
                In Transit
              </option>

              <option
                value="PARTIALLY_RECEIVED"
                <%= filters.status === 'PARTIALLY_RECEIVED' ? 'selected' : '' %>
              >
                Partially Received
              </option>

              <option
                value="RECEIVED"
                <%= filters.status === 'RECEIVED' ? 'selected' : '' %>
              >
                Received
              </option>

              <option
                value="CLOSED"
                <%= filters.status === 'CLOSED' ? 'selected' : '' %>
              >
                Closed
              </option>

              <option
                value="CANCELLED"
                <%= filters.status === 'CANCELLED' ? 'selected' : '' %>
              >
                Cancelled
              </option>
            </select>
          </div>

          <!-- Buttons -->
          <div class="col-md-3 d-flex align-items-end gap-2">

            <button
              type="submit"
              class="btn btn-primary"
            >
              Filter
            </button>

            <a
              href="/inventory/transfer-register"
              class="btn btn-outline-secondary"
            >
              Reset
            </a>

          </div>

          <!-- Date From -->
          <div class="col-md-3">
            <label class="form-label">
              Created From
            </label>

            <input
              type="date"
              name="dateFrom"
              class="form-control"
              value="<%= filters.dateFrom %>"
            >
          </div>

          <!-- Date To -->
          <div class="col-md-3">
            <label class="form-label">
              Created To
            </label>

            <input
              type="date"
              name="dateTo"
              class="form-control"
              value="<%= filters.dateTo %>"
            >
          </div>

        </div>

      </form>

    </div>
  </div>


  <!-- ============================================================
       TRANSFER TABLE
       ============================================================ -->

  <div class="card shadow-sm">

    <div class="card-header d-flex justify-content-between align-items-center">
      <strong>Transfers</strong>

      <span class="text-muted">
        <%= transfers.length %> transfer<%= transfers.length === 1 ? '' : 's' %>
      </span>
    </div>

    <div class="card-body p-0">

      <% if (!transfers.length) { %>

        <div class="p-4 text-center text-muted">
          No stock transfers found.
        </div>

      <% } else { %>

        <div class="table-responsive">

          <table class="table table-hover table-striped mb-0 align-middle">

            <thead class="table-light">
              <tr>

                <th>Transfer</th>

                <th>From</th>

                <th>To</th>

                <th>Created</th>

                <th>Items</th>

                <th>Received</th>

                <th>Outstanding</th>

                <th>Status</th>

                <th class="text-end">
                  Action
                </th>

              </tr>
            </thead>

            <tbody>

              <% transfers.forEach(transfer => { %>

                <%
                  const statusClass = {
                    DRAFT: 'bg-secondary',
                    IN_TRANSIT: 'bg-primary',
                    PARTIALLY_RECEIVED: 'bg-warning text-dark',
                    RECEIVED: 'bg-success',
                    CLOSED: 'bg-dark',
                    CANCELLED: 'bg-danger'
                  }[transfer.status] || 'bg-secondary';

                  const itemCount = Number(transfer.item_count || 0);
                  const receivedCount = Number(transfer.received_count || 0);
                  const outstandingCount =
                    Number(transfer.in_transit_count || 0);
                %>

                <tr>

                  <!-- Transfer -->
                  <td>
                    <a
                      href="/inventory/transfers/<%= transfer.id %>"
                      class="fw-semibold text-decoration-none"
                    >
                      <%= transfer.transfer_number %>
                    </a>
                  </td>

                  <!-- From -->
                  <td>
                    <div class="fw-semibold">
                      <%= transfer.from_site_code %>
                    </div>

                    <small class="text-muted">
                      <%= transfer.from_site_name %>
                    </small>
                  </td>

                  <!-- To -->
                  <td>
                    <div class="fw-semibold">
                      <%= transfer.to_site_code %>
                    </div>

                    <small class="text-muted">
                      <%= transfer.to_site_name %>
                    </small>
                  </td>

                  <!-- Created -->
                  <td>
                    <%= new Date(transfer.created_at).toLocaleString() %>
                  </td>

                  <!-- Items -->
                  <td>
                    <%= itemCount %>
                  </td>

                  <!-- Received -->
                  <td>
                    <%= receivedCount %>
                  </td>

                  <!-- Outstanding -->
                  <td>

                    <% if (outstandingCount > 0) { %>

                      <span class="text-warning fw-semibold">
                        <%= outstandingCount %>
                      </span>

                    <% } else { %>

                      <span class="text-muted">
                        0
                      </span>

                    <% } %>

                  </td>

                  <!-- Status -->
                  <td>
                    <span class="badge <%= statusClass %>">
                      <%= transfer.status.replace(/_/g, ' ') %>
                    </span>
                  </td>

                  <!-- Action -->
                  <td class="text-end">

                    <a
                      href="/inventory/transfers/<%= transfer.id %>"
                      class="btn btn-sm btn-outline-primary"
                    >
                      View
                    </a>

                  </td>

                </tr>

              <% }) %>

            </tbody>

          </table>

        </div>

      <% } %>

    </div>

  </div>

</div>