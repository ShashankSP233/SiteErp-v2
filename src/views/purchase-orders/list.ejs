<div class="container-fluid py-3">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="mb-1">Purchase Orders</h2>
            <p class="text-muted mb-0">
                Manage purchase orders received from the Purchase Department.
            </p>
        </div>

        <% if (currentUser && ['admin', 'manager'].includes(currentUser.role)) { %>
            <a href="/purchase-orders/new" class="btn btn-primary">
                + Create Purchase Order
            </a>
        <% } %>
    </div>


    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <strong>Filters</strong>
        </div>

        <div class="card-body">

            <form method="GET" action="/purchase-orders">

                <div class="row g-3 align-items-end">

                    <div class="col-md-3">
                        <label class="form-label">Status</label>

                        <select name="status" class="form-select">
                            <option value="">All Statuses</option>

                            <% ['DRAFT', 'SENT', 'PARTIALLY_RECEIVED', 'COMPLETED', 'CANCELLED'].forEach(status => { %>
                                <option
                                    value="<%= status %>"
                                    <%= filters.status === status ? 'selected' : '' %>
                                >
                                    <%= status.replaceAll('_', ' ') %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Vendor</label>

                        <select name="vendorId" class="form-select">
                            <option value="">All Vendors</option>

                            <% vendors.forEach(vendor => { %>
                                <option
                                    value="<%= vendor.id %>"
                                    <%= String(filters.vendorId) === String(vendor.id) ? 'selected' : '' %>
                                >
                                    <%= vendor.vendor_code %> -
                                    <%= vendor.name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Site</label>

                        <select name="siteId" class="form-select">
                            <option value="">All Sites</option>

                            <% sites.forEach(site => { %>
                                <option
                                    value="<%= site.id %>"
                                    <%= String(filters.siteId) === String(site.id) ? 'selected' : '' %>
                                >
                                    <%= site.code %> -
                                    <%= site.name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            Filter
                        </button>

                        <a
                            href="/purchase-orders"
                            class="btn btn-outline-secondary"
                        >
                            Reset
                        </a>
                    </div>

                </div>

            </form>

        </div>
    </div>


    <!-- PO List -->
    <div class="card shadow-sm">

        <div class="card-header">
            <strong>Purchase Order List</strong>
        </div>

        <div class="card-body p-0">

            <% if (!purchaseOrders || purchaseOrders.length === 0) { %>

                <div class="text-center py-5">
                    <h5>No Purchase Orders found</h5>

                    <p class="text-muted">
                        No Purchase Orders match the current filters.
                    </p>

                    <% if (currentUser && ['admin', 'manager'].includes(currentUser.role)) { %>
                        <a
                            href="/purchase-orders/new"
                            class="btn btn-primary"
                        >
                            Create Purchase Order
                        </a>
                    <% } %>
                </div>

            <% } else { %>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>PO Number</th>
                                <th>Vendor</th>
                                <th>Site</th>
                                <th>PO Date</th>
                                <th>Expected Delivery</th>
                                <th>Items</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% purchaseOrders.forEach(po => { %>

                                <tr>

                                    <td>
                                        <strong>
                                            <%= po.po_number %>
                                        </strong>
                                    </td>

                                    <td>
                                        <%= po.vendor_code %>
                                        -
                                        <%= po.vendor_name %>
                                    </td>

                                    <td>
                                        <%= po.site_code %>
                                        -
                                        <%= po.site_name %>
                                    </td>

                                    <td>
                                        <%= po.po_date
                                            ? new Date(po.po_date).toLocaleDateString()
                                            : '-' %>
                                    </td>

                                    <td>
                                        <%= po.expected_delivery_date
                                            ? new Date(po.expected_delivery_date).toLocaleDateString()
                                            : '-' %>
                                    </td>

                                    <td>
                                        <%= po.line_count %>
                                    </td>

                                    <td>

                                        <% if (po.status === 'DRAFT') { %>
                                            <span class="badge bg-secondary">
                                                Draft
                                            </span>

                                        <% } else if (po.status === 'SENT') { %>
                                            <span class="badge bg-primary">
                                                Sent
                                            </span>

                                        <% } else if (po.status === 'PARTIALLY_RECEIVED') { %>
                                            <span class="badge bg-warning text-dark">
                                                Partially Received
                                            </span>

                                        <% } else if (po.status === 'COMPLETED') { %>
                                            <span class="badge bg-success">
                                                Completed
                                            </span>

                                        <% } else { %>
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        <% } %>

                                    </td>

                                    <td class="text-end">
                                        <a
                                            href="/purchase-orders/<%= po.id %>"
                                            class="btn btn-sm btn-outline-primary"
                                        >
                                            View
                                        </a>
                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>
                </div>

            <% } %>

        </div>
    </div>

</div>