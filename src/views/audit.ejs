<h2 class="mb-3">Audit Trail</h2>
<div class="card shadow-sm"><div class="card-body table-responsive"><table class="table table-striped data-table align-middle">
<thead><tr><th>Time</th><th>User</th><th>Action</th><th>Record</th><th>Change / Details</th></tr></thead><tbody>
<%
function fmtDetails(d){
  if(!d) return '';
  let obj = d;
  if(typeof d === 'string'){ try{ obj = JSON.parse(d); }catch(_){ return d; } }
  if(typeof obj !== 'object' || obj === null) return String(obj);
  const skip = new Set(['_csrf','attachment','password','confirmPassword','newPassword']);
  const parts = [];
  for(const k of Object.keys(obj)){
    if(skip.has(k)) continue;
    let v = obj[k];
    if(v === null || v === undefined || v === '') continue;
    if(typeof v === 'object') v = JSON.stringify(v);
    parts.push(k + ': ' + v);
  }
  return parts.join(' · ');
}
%>
<% logs.forEach(l => { %>
<tr>
  <td class="text-nowrap"><%= new Date(l.created_at).toLocaleString() %></td>
  <td><%= l.username || '' %></td>
  <td><span class="badge text-bg-secondary"><%= l.action %></span></td>
  <td><span class="text-muted small"><%= l.entity || '' %><%= l.entity_id ? ' #' + l.entity_id : '' %></span></td>
  <td class="small"><%= fmtDetails(l.details) %></td>
</tr>
<% }) %>
</tbody></table></div>
<div class="text-muted small px-2 pb-2">IP/user-agent are retained on each record for security but hidden here to keep the focus on what changed.</div>
</div>
