<div class="d-flex justify-content-between align-items-center mb-4">

  <div>
    <h1 class="h3 mb-1">Item Masters</h1>

    <p class="text-muted mb-0">
      Define the types of physical inventory managed by Site-ERP.
    </p>
  </div>

  <% if (['admin', 'manager'].includes(currentUser?.role)) { %>

    <a
      href="/items/new"
      class="btn btn-primary"
    >
      Create Item
    </a>

  <% } %>

</div>


<div class="card shadow-sm">

  <div class="card-body p-0">

    <% if (!items.length) { %>

      <div class="p-4 text-center text-muted">
        No item masters have been created yet.
      </div>

    <% } else { %>

      <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

          <thead>

            <tr>
              <th>Code</th>
              <th>Name</th>
              <th>Category</th>
              <th>Unit</th>
              <th>Type</th>
              <th>Instances</th>
              <th>Current Qty</th>
              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>

          </thead>

          <tbody>

            <% items.forEach(item => { %>

              <tr>

                <td>
                  <strong>
                    <%= item.item_code %>
                  </strong>
                </td>

                <td>
                  <%= item.name %>
                </td>

                <td>
                  <%= item.category || '—' %>
                </td>

                <td>
                  <%= item.unit %>
                </td>

                <td>

                  <% if (item.is_consumable) { %>

                    <span class="badge text-bg-warning">
                      Consumable
                    </span>

                  <% } else { %>

                    <span class="badge text-bg-secondary">
                      Non-consumable
                    </span>

                  <% } %>

                </td>

                <td>
                  <%= Number(item.instance_count) %>
                </td>

                <td>
                  <%= Number(item.total_current_quantity) %>
                  <%= item.unit %>
                </td>

                <td>

                  <% if (item.status === 'ACTIVE') { %>

                    <span class="badge text-bg-success">
                      Active
                    </span>

                  <% } else { %>

                    <span class="badge text-bg-secondary">
                      <%= item.status %>
                    </span>

                  <% } %>

                </td>

                <td class="text-end">

                  <a
                    href="/items/<%= item.id %>/edit"
                    class="btn btn-sm btn-outline-secondary"
                  >
                    Edit
                  </a>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    <% } %>

  </div>

</div>