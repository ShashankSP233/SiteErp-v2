<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

  <div>
    <div class="text-muted small mb-1">
      Inventory / Item Master / Details
    </div>

    <h1 class="h3 mb-1">
      <%= itemMaster.item_code %>
    </h1>

    <p class="text-muted mb-0">
      <%= itemMaster.description || itemMaster.name || 'Item Master' %>
    </p>
  </div>

  <div class="d-flex gap-2">

    <a
      href="/items"
      class="btn btn-outline-secondary"
    >
      Back to Items
    </a>

    <a
      href="/items/<%= itemMaster.id %>/ledger"
      class="btn btn-outline-secondary"
    >
      Ledger
    </a>

    <% if (['admin', 'manager'].includes(currentUser?.role)) { %>
      <a
        href="/items/<%= itemMaster.id %>/edit"
        class="btn btn-primary"
      >
        Edit
      </a>
    <% } %>

  </div>

</div>


<!-- ============================================================
     ITEM MASTER SUMMARY
     ============================================================ -->

<div class="row g-3 mb-4">

  <div class="col-md-3">
    <div class="card shadow-sm h-100">
      <div class="card-body">

        <div class="text-muted small mb-1">
          Item Code
        </div>

        <div class="fw-semibold fs-5">
          <%= itemMaster.item_code %>
        </div>

      </div>
    </div>
  </div>


  <div class="col-md-3">
    <div class="card shadow-sm h-100">
      <div class="card-body">

        <div class="text-muted small mb-1">
          Physical Unit
        </div>

        <div class="fw-semibold fs-5">
          <%= itemMaster.unit || '—' %>
        </div>

      </div>
    </div>
  </div>


  <div class="col-md-3">
    <div class="card shadow-sm h-100">
      <div class="card-body">

        <div class="text-muted small mb-1">
          Total Instances
        </div>

        <div class="fw-semibold fs-5">
          <%= totalInstances %>
        </div>

      </div>
    </div>
  </div>


  <div class="col-md-3">
    <div class="card shadow-sm h-100">
      <div class="card-body">

        <div class="text-muted small mb-1">
          Current Quantity
        </div>

        <div class="fw-semibold fs-5">
            <%= totalQuantity %>

            <span class="text-muted fs-6">
                <%= itemMaster.instance_quantity_unit || '' %>
            </span>

        </div>

      </div>
    </div>
  </div>

</div>

<div class="row g-3 mb-4">
  <div class="col-sm-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">In transit</div><div class="fs-4 fw-semibold"><%= inTransitCount %></div></div></div></div>
  <div class="col-sm-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Damaged</div><div class="fs-4 fw-semibold"><%= damagedCount %></div></div></div></div>
  <div class="col-sm-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Matching filters</div><div class="fs-4 fw-semibold"><%= instances.length %></div></div></div></div>
</div>


<!-- ============================================================
     ITEM MASTER INFORMATION
     ============================================================ -->

<div class="card shadow-sm mb-4">

  <div class="card-header bg-white py-3">
    <h2 class="h5 mb-0">
      Item Master Information
    </h2>
  </div>

  <div class="card-body">

    <div class="row g-3">

      <div class="col-md-4">

        <div class="text-muted small">
          Name
        </div>

        <div class="fw-semibold">
          <%= itemMaster.name || '—' %>
        </div>

      </div>


      <div class="col-md-4">

        <div class="text-muted small">
          Category
        </div>

        <div class="fw-semibold">
          <%= itemMaster.category || '—' %>
        </div>

      </div>


      <div class="col-md-4">

        <div class="text-muted small">
          Status
        </div>

        <% const masterStatus =
          String(itemMaster.status || '').toUpperCase();
        %>

        <% if (masterStatus === 'ACTIVE') { %>

          <span class="badge text-bg-success">
            Active
          </span>

        <% } else if (masterStatus === 'INACTIVE') { %>

          <span class="badge text-bg-secondary">
            Inactive
          </span>

        <% } else { %>

          <span class="badge text-bg-warning">
            <%= itemMaster.status || 'Unknown' %>
          </span>

        <% } %>

      </div>


      <div class="col-md-4">

        <div class="text-muted small">
          Per Instance
        </div>

        <div class="fw-semibold">
          <%= itemMaster.instance_quantity ?? '—' %>
          <span class="text-muted">
            <%= itemMaster.instance_quantity_unit || '' %>
          </span>
        </div>

      </div>


      <div class="col-md-4">

        <div class="text-muted small">
          Consumable
        </div>

        <span class="badge <%= itemMaster.is_consumable
          ? 'text-bg-success'
          : 'text-bg-secondary' %>">

          <%= itemMaster.is_consumable ? 'Yes' : 'No' %>

        </span>

      </div>


      <div class="col-md-4">

        <div class="text-muted small">
          Partial Consumption
        </div>

        <span class="badge <%= itemMaster.allows_partial_consumption
          ? 'text-bg-success'
          : 'text-bg-secondary' %>">

          <%= itemMaster.allows_partial_consumption
            ? 'Yes'
            : 'No' %>

        </span>

      </div>


      <div class="col-md-4">

        <div class="text-muted small">
          Instance Tracking
        </div>

        <span class="badge <%= itemMaster.requires_instance_tracking
          ? 'text-bg-success'
          : 'text-bg-secondary' %>">

          <%= itemMaster.requires_instance_tracking
            ? 'Yes'
            : 'No' %>

        </span>

      </div>


      <% if (itemMaster.description) { %>

        <div class="col-12">

          <div class="text-muted small">
            Description
          </div>

          <div>
            <%= itemMaster.description %>
          </div>

        </div>

      <% } %>

    </div>

  </div>

</div>


<!-- ============================================================
     PHYSICAL INSTANCES
     ============================================================ -->

<div class="card shadow-sm">

  <div class="card-header bg-white py-3">

    <div class="d-flex justify-content-between align-items-center">

      <div>

        <h2 class="h5 mb-1">
          Physical Instances
        </h2>

        <div class="text-muted small">
          Filter by site, lifecycle status, or condition. Counts above summarize all accessible instances.
        </div>

      </div>

      <span class="badge text-bg-light border">
        <%= instances.length %> of <%= totalInstances %> instances
      </span>

    </div>

  </div>


  <div class="card-body border-bottom">
    <form method="get" action="/items/<%= itemMaster.id %>/ledger" class="row g-2 align-items-end">
      <div class="col-md-4">
        <label class="form-label" for="site-filter">Site</label>
        <select class="form-select" id="site-filter" name="site">
          <option value="">All sites</option>
          <% sites.forEach(site => { %><option value="<%= site.id %>" <%= filters.site === site.id ? 'selected' : '' %>><%= site.label %></option><% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label" for="status-filter">Status</label>
        <select class="form-select" id="status-filter" name="status">
          <option value="">All statuses</option>
          <% statuses.forEach(status => { %><option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status.replace(/_/g, ' ') %></option><% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label" for="condition-filter">Condition</label>
        <select class="form-select" id="condition-filter" name="condition">
          <option value="">All conditions</option>
          <% conditions.forEach(condition => { %><option value="<%= condition %>" <%= filters.condition === condition ? 'selected' : '' %>><%= condition %></option><% }) %>
        </select>
      </div>
      <div class="col-md-2 d-flex gap-2">
        <button class="btn btn-primary flex-grow-1" type="submit">Filter</button>
        <a class="btn btn-outline-secondary" href="/items/<%= itemMaster.id %>/ledger">Clear</a>
      </div>
    </form>
  </div>

  <% if (!instances.length) { %>

    <div class="card-body text-center text-muted py-5">

      No physical instances exist for this item master.

    </div>

  <% } else { %>

    <div class="table-responsive">

      <table class="table table-hover align-middle mb-0">

        <thead class="table-light">

          <tr>

            <th>Instance</th>
            <th>Barcode</th>
            <th>Original Qty</th>
            <th>Current Qty</th>
            <th>Location</th>
            <th>Status</th>
            <th>Condition</th>

          </tr>

        </thead>


        <tbody>

          <% instances.forEach(instance => { %>

            <% const instanceStatus =
              String(instance.lifecycle_status || '').toUpperCase();
            %>

            <tr>

              <!-- Instance Code -->

              <td>

                <strong>
                  <%= instance.instance_code %>
                </strong>

              </td>


              <!-- Barcode -->

              <td>

                <% if (instance.barcode) { %>

                  <code>
                    <%= instance.barcode %>
                  </code>

                <% } else { %>

                  <span class="text-muted">
                    —
                  </span>

                <% } %>

              </td>


              <!-- Original Quantity -->

              <td class="text-nowrap">

                <strong>
                  <%= instance.original_quantity ?? '—' %>
                </strong>

                <span class="text-muted">
                  <%= instance.unit || itemMaster.unit || '' %>
                </span>

              </td>


              <!-- Current Quantity -->

              <td class="text-nowrap">

                <strong>
                  <%= instance.current_quantity ?? '—' %>
                </strong>

                <span class="text-muted">
                  <%= instance.unit || itemMaster.unit || '' %>
                </span>

              </td>


              <!-- Location -->

              <td>

                <% if (instance.site_code || instance.site_name) { %>

                  <strong>
                    <%= instance.site_code || '—' %>
                  </strong>

                  <% if (instance.site_name) { %>

                    <div class="small text-muted">
                      <%= instance.site_name %>
                    </div>

                  <% } %>

                <% } else { %>

                  <span class="text-muted">
                    No site
                  </span>

                <% } %>

              </td>


              <!-- Lifecycle Status -->

              <td>

                <% if (instanceStatus === 'ACTIVE') { %>

                  <span class="badge text-bg-success">
                    Active
                  </span>

                <% } else if (instanceStatus === 'MIA') { %>

                  <span class="badge text-bg-danger">
                    MIA
                  </span>

                <% } else if (instanceStatus === 'LOST') { %>

                  <span class="badge text-bg-danger">
                    Lost
                  </span>

                <% } else if (instanceStatus === 'CONSUMED') { %>

                  <span class="badge text-bg-warning">
                    Consumed
                  </span>

                <% } else if (instanceStatus === 'DISPOSED') { %>

                  <span class="badge text-bg-dark">
                    Disposed
                  </span>

                <% } else if (instanceStatus === 'QUARANTINED') { %>

                  <span class="badge text-bg-warning">
                    Quarantined
                  </span>

                <% } else { %>

                  <span class="badge text-bg-secondary">
                    <%= instance.lifecycle_status || 'Unknown' %>
                  </span>

                <% } %>

              </td>


              <!-- Condition -->

              <td>

                <%= instance.condition || '—' %>

                <% if (instance.brand) { %>
                  <div class="small text-muted">Brand: <%= instance.brand %></div>
                <% } %>

              </td>

            </tr>

          <% }) %>

        </tbody>

      </table>

    </div>

  <% } %>

</div>
