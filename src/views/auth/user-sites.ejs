<div class="d-flex justify-content-between align-items-center mb-4">

  <div>

    <h2 class="mb-1">
      Manage User Sites
    </h2>

    <div class="text-muted">
      <strong><%= user.username %></strong>
      —
      <%= user.full_name || '' %>
    </div>

  </div>

  <a
    href="/users"
    class="btn btn-outline-secondary"
  >
    Back to Users
  </a>

</div>


<div class="row g-4">


  <!-- USER INFORMATION -->

  <div class="col-lg-4">
    <div class="card shadow-sm">
      <div class="card-header">
        <strong>User Details</strong>
      </div>

      <div class="card-body">
        <form method="post" action="/users/<%= user.id %>/edit">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input
              id="username"
              name="username"
              class="form-control"
              value="<%= user.username %>"
              required
            >
          </div>

          <div class="mb-3">
            <label for="fullName" class="form-label">Full Name</label>
            <input
              id="fullName"
              name="fullName"
              class="form-control"
              value="<%= user.full_name || '' %>"
            >
          </div>

          <div class="mb-3">
            <label for="role" class="form-label">Role</label>
            <select id="role" name="role" class="form-select" required>
              <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Admin</option>
              <option value="manager" <%= user.role === 'manager' ? 'selected' : '' %>>Manager</option>
              <option value="operator" <%= user.role === 'operator' ? 'selected' : '' %>>Operator</option>
              <option value="viewer" <%= user.role === 'viewer' ? 'selected' : '' %>>Viewer</option>
            </select>
          </div>

          <div class="form-check form-switch mb-3">
            <input
              id="isActive"
              name="isActive"
              type="checkbox"
              class="form-check-input"
              <%= user.is_active ? 'checked' : '' %>
            >
            <label for="isActive" class="form-check-label">Active account</label>
          </div>

          <hr>

          <div class="mb-3">
            <label for="password" class="form-label">Reset Password</label>
            <input
              id="password"
              name="password"
              type="password"
              class="form-control"
              minlength="8"
              autocomplete="new-password"
            >
            <div class="form-text">
              Leave blank to keep the current password. A new password must be at least 8 characters.
            </div>
          </div>

          <button type="submit" class="btn btn-primary w-100">
            Save User
          </button>
        </form>
      </div>
    </div>

    <% if (user.role === 'operator') { %>
      <div class="alert alert-info mt-3">
        <strong>Operator rule</strong>
        <div class="small mt-1">
          An operator can be assigned to exactly one active site.
        </div>
      </div>
    <% } %>

    <% if (user.role === 'manager') { %>
      <div class="alert alert-info mt-3">
        <strong>Manager rule</strong>
        <div class="small mt-1">
          A manager can be assigned to multiple active sites.
        </div>
      </div>
    <% } %>
  </div>


  <!-- CURRENT ASSIGNMENTS -->

  <div class="col-lg-8">

    <div class="card shadow-sm mb-4">

      <div class="card-header">
        <strong>Current Site Assignments</strong>
      </div>

      <div class="card-body">

        <% const activeSites = user.sites.filter(
          s => !s.assigned_until
        ); %>


        <% if (!activeSites.length) { %>

          <p class="text-muted mb-0">
            No active site assignments.
          </p>

        <% } else { %>

          <div class="table-responsive">

            <table class="table table-sm align-middle mb-0">

              <thead>

                <tr>
                  <th>Code</th>
                  <th>Site</th>
                  <th>Type</th>
                  <th>Primary</th>
                  <th class="text-end">Action</th>
                </tr>

              </thead>

              <tbody>

                <% activeSites.forEach(site => { %>

                  <tr>

                    <td>
                      <strong>
                        <%= site.code %>
                      </strong>
                    </td>

                    <td>
                      <%= site.name %>
                    </td>

                    <td>
                      <%= site.site_type === 'SUPER_STORE'
                        ? 'Super-Store'
                        : 'Normal Site' %>
                    </td>

                    <td>

                      <% if (site.is_primary) { %>

                        <span class="badge text-bg-primary">
                          Primary
                        </span>

                      <% } else { %>

                        <span class="text-muted">
                          —
                        </span>

                      <% } %>

                    </td>

                    <td class="text-end">

                      <form
                        method="post"
                        action="/users/<%= user.id %>/sites/<%= site.id %>/remove"
                        class="d-inline"
                      >

                        <input
                          type="hidden"
                          name="_csrf"
                          value="<%= csrfToken %>"
                        >

                        <button
                          type="submit"
                          class="btn btn-sm btn-outline-danger"
                          onclick="return confirm('Remove this site assignment?')"
                        >
                          Remove
                        </button>

                      </form>

                    </td>

                  </tr>

                <% }) %>

              </tbody>

            </table>

          </div>

        <% } %>

      </div>

    </div>


    <!-- ADD ASSIGNMENT -->

    <% if (user.role !== 'admin') { %>

      <div class="card shadow-sm">

        <div class="card-header">
          <strong>Assign Site</strong>
        </div>

        <div class="card-body">

          <form
            method="post"
            action="/users/<%= user.id %>/sites"
          >

            <input
              type="hidden"
              name="_csrf"
              value="<%= csrfToken %>"
            >


            <div class="row g-3 align-items-end">

              <div class="col-md-7">

                <label class="form-label">
                  Site
                </label>

                <select
                  name="siteId"
                  class="form-select"
                  required
                >

                  <option value="">
                    Select site
                  </option>

                  <% sites
                    .filter(site => site.status === 'ACTIVE')
                    .forEach(site => {
                  %>

                    <option value="<%= site.id %>">

                      <%= site.code %>
                      —
                      <%= site.name %>

                      <% if (site.site_type === 'SUPER_STORE') { %>
                        (Super-Store)
                      <% } %>

                    </option>

                  <% }) %>

                </select>

              </div>


              <div class="col-md-3">

                <% if (user.role !== 'operator') { %>

                  <div class="form-check">

                    <input
                      class="form-check-input"
                      type="checkbox"
                      name="isPrimary"
                      id="isPrimary"
                    >

                    <label
                      class="form-check-label"
                      for="isPrimary"
                    >
                      Primary site
                    </label>

                  </div>

                <% } else { %>

                  <div class="form-text">
                    Operator assignment automatically
                    becomes primary.
                  </div>

                <% } %>

              </div>


              <div class="col-md-2">

                <button
                  type="submit"
                  class="btn btn-primary w-100"
                >
                  Assign
                </button>

              </div>

            </div>

          </form>

        </div>

      </div>

    <% } %>

  </div>

</div>