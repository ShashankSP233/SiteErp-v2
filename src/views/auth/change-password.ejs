<div class="row justify-content-center mt-5"><div class="col-md-5 col-lg-4"><div class="card shadow">
  <div class="card-body p-4">
    <h3>Change Password</h3>
    <% if (currentUser && currentUser.must_change_password) { %><p class="text-muted">Set a new password before continuing.</p><% } %>
    <form method="post" action="/change-password">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="mb-3"><label class="form-label">New Password</label><input name="newPassword" type="password" minlength="8" class="form-control" required autofocus></div>
      <div class="mb-3"><label class="form-label">Confirm Password</label><input name="confirmPassword" type="password" minlength="8" class="form-control" required></div>
      <div class="form-text mb-3">Minimum 8 characters.</div>
      <button class="btn btn-primary w-100">Update Password</button>
    </form>
  </div>
</div></div></div>
