<div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="mb-0">Bills</h2><div class="text-muted small">Page <%= page %> of <%= totalPages %> (<%= total %>)</div></div><a class="btn btn-primary" href="/bills/new">Add Bill</a></div>
<div class="card shadow-sm"><div class="card-body table-responsive"><table class="table table-striped data-table align-middle">
<thead><tr><th>Bill No</th><th>Date</th><th>Vendor</th><th>GRN</th><th>Total</th><th>Paid</th><th>Outstanding</th><th>Status</th><th></th></tr></thead><tbody>
<% bills.forEach(b => { const out = Number(b.total)-Number(b.paid||0); const sc={submitted:'warning',approved:'info',part_paid:'primary',paid:'success',rejected:'danger',draft:'secondary'}[b.status]||'secondary'; %>
<tr><td><strong><%= b.bill_no %></strong></td><td><%= new Date(b.bill_date).toLocaleDateString() %></td><td><%= b.vendor || '' %></td><td><%= b.grn_no || '' %></td>
<td>₹<%= Number(b.total).toLocaleString('en-IN') %></td><td>₹<%= Number(b.paid||0).toLocaleString('en-IN') %></td><td>₹<%= out.toLocaleString('en-IN') %></td>
<td><span class="badge text-bg-<%= sc %>"><%= b.status %></span></td><td><a class="btn btn-sm btn-outline-primary" href="/bills/<%= b.id %>">Open</a></td></tr><% }) %>
</tbody></table></div></div>
<% if (totalPages > 1) { %><nav class="mt-3"><ul class="pagination justify-content-center">
<li class="page-item <%= page<=1?'disabled':'' %>"><a class="page-link" href="/bills?page=<%= page-1 %>">Previous</a></li>
<li class="page-item disabled"><span class="page-link"><%= page %> / <%= totalPages %></span></li>
<li class="page-item <%= page>=totalPages?'disabled':'' %>"><a class="page-link" href="/bills?page=<%= page+1 %>">Next</a></li>
</ul></nav><% } %>
