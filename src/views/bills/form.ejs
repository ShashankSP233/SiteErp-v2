<div class="d-flex justify-content-between align-items-center mb-3"><h2 class="mb-0">Add Bill</h2><a class="btn btn-outline-secondary" href="/bills">Back</a></div>
<form method="post" action="/bills?_csrf=<%= csrfToken %>" enctype="multipart/form-data" class="card shadow-sm"><div class="card-body row g-3">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="col-md-4"><label class="form-label">Bill No *</label><input name="billNo" class="form-control" required></div>
  <div class="col-md-4"><label class="form-label">Vendor</label><input name="vendor" list="vList" class="form-control"></div>
  <div class="col-md-4"><label class="form-label">Bill Date</label><input name="billDate" type="date" class="form-control"></div>
  <div class="col-md-4"><label class="form-label">Link GRN (optional)</label><input name="grnNo" list="gList" class="form-control" placeholder="Received-goods reference"></div>
  <div class="col-md-4"><label class="form-label">Amount *</label><input name="amount" type="number" min="0" step="0.01" class="form-control" required></div>
  <div class="col-md-4"><label class="form-label">Tax</label><input name="tax" type="number" min="0" step="0.01" value="0" class="form-control"></div>
  <div class="col-md-8"><label class="form-label">Notes</label><input name="notes" class="form-control"></div>
  <div class="col-md-4"><label class="form-label">Attachment (image/PDF)</label><input name="attachment" type="file" accept="image/*,.pdf" class="form-control"></div>
  <div class="col-12"><button class="btn btn-primary">Save & Submit for Approval</button></div>
</div></form>
<datalist id="vList"><% vendors.forEach(v => { %><option value="<%= v.name %>"></option><% }) %></datalist>
<datalist id="gList"><% grns.forEach(g => { %><option value="<%= g.grn_no %>"></option><% }) %></datalist>
