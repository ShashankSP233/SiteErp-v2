<% const sc={submitted:'warning',approved:'info',part_paid:'primary',paid:'success',rejected:'danger',draft:'secondary'}[bill.status]||'secondary'; %>
<div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="mb-0">Bill <%= bill.bill_no %> <span class="badge text-bg-<%= sc %>"><%= bill.status %></span></h2><div class="text-muted small"><%= bill.vendor || 'No vendor' %> · <%= new Date(bill.bill_date).toLocaleDateString() %></div></div><a class="btn btn-outline-secondary" href="/bills">Back</a></div>
<div class="row g-3">
  <div class="col-lg-5"><div class="card shadow-sm"><div class="card-body">
    <table class="table table-sm mb-2">
      <tr><td>Amount</td><td class="text-end">₹<%= Number(bill.amount).toLocaleString('en-IN') %></td></tr>
      <tr><td>Tax</td><td class="text-end">₹<%= Number(bill.tax).toLocaleString('en-IN') %></td></tr>
      <tr class="fw-bold"><td>Total</td><td class="text-end">₹<%= Number(bill.total).toLocaleString('en-IN') %></td></tr>
      <tr><td>Paid</td><td class="text-end">₹<%= Number(bill.paid).toLocaleString('en-IN') %></td></tr>
      <tr class="fw-bold text-danger"><td>Outstanding</td><td class="text-end">₹<%= Number(bill.outstanding).toLocaleString('en-IN') %></td></tr>
    </table>
    <% if (bill.grn_no) { %><div class="small text-muted">Linked GRN: <%= bill.grn_no %></div><% } %>
    <% if (bill.notes) { %><div class="small">Notes: <%= bill.notes %></div><% } %>
    <% if (bill.attachment) { %><div class="mt-2"><a href="<%= bill.attachment %>" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">View attachment</a></div><% } %>
    <div class="small text-muted mt-2">Created by <%= bill.created_by_name || '—' %>. <% if (bill.approved_by_name) { %><%= bill.status %> by <%= bill.approved_by_name %>.<% } %></div>
  </div></div></div>

  <div class="col-lg-7">
    <% if (bill.status === 'submitted' && ['admin','manager'].includes(currentUser.role)) { %>
    <div class="card shadow-sm mb-3"><div class="card-header"><strong>Approval</strong></div><div class="card-body">
      <form method="post" action="/bills/<%= bill.id %>/decision" class="row g-2">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="col-md-8"><input name="remarks" class="form-control" placeholder="Remarks (optional)"></div>
        <div class="col-md-2 d-grid"><button name="decision" value="approve" class="btn btn-success">Approve</button></div>
        <div class="col-md-2 d-grid"><button name="decision" value="reject" class="btn btn-outline-danger">Reject</button></div>
      </form>
    </div></div>
    <% } %>

    <% if (['approved','part_paid'].includes(bill.status) && ['admin','manager'].includes(currentUser.role)) { %>
    <div class="card shadow-sm mb-3"><div class="card-header"><strong>Record Payment</strong></div><div class="card-body">
      <form method="post" action="/bills/<%= bill.id %>/payments" class="row g-2">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="col-md-3"><input name="amount" type="number" min="0.01" step="0.01" class="form-control" placeholder="Amount" required></div>
        <div class="col-md-3"><select name="mode" class="form-select"><option value="bank">Bank</option><option value="cash">Cash</option><option value="upi">UPI</option><option value="cheque">Cheque</option><option value="other">Other</option></select></div>
        <div class="col-md-3"><input name="paymentDate" type="date" class="form-control"></div>
        <div class="col-md-3"><input name="referenceNo" class="form-control" placeholder="Ref no"></div>
        <div class="col-12 d-grid"><button class="btn btn-primary">Add Payment</button></div>
      </form>
    </div></div>
    <% } %>

    <div class="card shadow-sm"><div class="card-header"><strong>Payments</strong></div><div class="card-body table-responsive">
      <% if (!bill.payments.length) { %><p class="text-muted mb-0">No payments yet.</p><% } else { %>
      <table class="table table-sm mb-0"><thead><tr><th>Date</th><th>Amount</th><th>Mode</th><th>Ref</th><th>By</th></tr></thead><tbody>
      <% bill.payments.forEach(p => { %><tr><td><%= new Date(p.payment_date).toLocaleDateString() %></td><td>₹<%= Number(p.amount).toLocaleString('en-IN') %></td><td><%= p.mode %></td><td><%= p.reference_no || '' %></td><td><%= p.username || '' %></td></tr><% }) %>
      </tbody></table><% } %>
    </div></div>
  </div>
</div>
