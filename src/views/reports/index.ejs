<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="mb-0">Reports</h2>
  <div class="text-muted">Total stock value: <strong>₹<%= Number(totalValue).toLocaleString('en-IN') %></strong></div>
</div>
<div class="row g-3 mb-4">
  <div class="col-md-6"><div class="card shadow-sm"><div class="card-body">
    <h5>Inventory Valuation</h5><p class="text-muted small mb-2">Stock balance and value per item (weighted-average cost).</p>
    <a class="btn btn-sm btn-outline-success" href="/reports/stock.csv">CSV</a>
    <a class="btn btn-sm btn-outline-primary" href="/reports/inventory-print?view=valuation" target="_blank">Print / Save as PDF</a>
  </div></div></div>
  <div class="col-md-6"><div class="card shadow-sm"><div class="card-body">
    <h5>Stock by Location</h5><p class="text-muted small mb-2">Summed quantity &amp; value where item and location match.</p>
    <a class="btn btn-sm btn-outline-success" href="/reports/stock-by-location.csv">CSV</a>
    <a class="btn btn-sm btn-outline-primary" href="/reports/inventory-print?view=location" target="_blank">Print / Save as PDF</a>
  </div></div></div>
</div>
<div class="card shadow-sm"><div class="card-header d-flex justify-content-between"><strong>Stock by Location</strong><a class="btn btn-sm btn-outline-success" href="/reports/stock-by-location.csv">Export CSV</a></div>
<div class="card-body table-responsive"><table class="table table-striped data-table">
<thead><tr><th>Code</th><th>Description</th><th>Location</th><th>Quantity</th><th>Avg Cost</th><th>Value</th></tr></thead><tbody>
<% byLoc.forEach(r => { %><tr><td><%= r.item_code %></td><td><%= r.description %></td><td><%= r.location %></td><td><%= r.quantity %> <%= r.unit %></td><td>₹<%= Number(r.avg_cost).toFixed(2) %></td><td>₹<%= Number(r.value).toLocaleString('en-IN') %></td></tr><% }) %>
</tbody></table></div></div>
