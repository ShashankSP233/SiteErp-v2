<!doctype html><html><head><meta charset="utf-8"><title><%= title %></title>
<style>
  body{font-family:Arial,Helvetica,sans-serif;margin:24px;color:#222;font-size:12px}
  h1{font-size:18px;margin:0} .sub{color:#666;margin:2px 0 16px}
  table{width:100%;border-collapse:collapse;margin-top:8px}
  th,td{border:1px solid #ccc;padding:5px 7px;text-align:left}
  th{background:#f0f0f0} td.n,th.n{text-align:right}
  tfoot td{font-weight:bold;background:#f7f7f7}
  .toolbar{margin-bottom:12px} @media print{.toolbar{display:none}}
  button{padding:6px 12px;cursor:pointer}
</style></head><body>
<div class="toolbar"><button onclick="window.print()">Print / Save as PDF</button></div>
<h1><%= appName %> — <%= view==='location' ? 'Stock by Location' : 'Inventory Valuation' %></h1>
<div class="sub">Generated <%= printedAt %></div>
<% if (view==='location') { %>
<table><thead><tr><th>Code</th><th>Description</th><th>Location</th><th class="n">Qty</th><th class="n">Avg Cost</th><th class="n">Value</th></tr></thead><tbody>
<% byLoc.forEach(r => { %><tr><td><%= r.item_code %></td><td><%= r.description %></td><td><%= r.location %></td><td class="n"><%= r.quantity %></td><td class="n"><%= Number(r.avg_cost).toFixed(2) %></td><td class="n"><%= Number(r.value).toFixed(2) %></td></tr><% }) %>
</tbody><tfoot><tr><td colspan="5">Total</td><td class="n"><%= Number(byLocValue).toFixed(2) %></td></tr></tfoot></table>
<% } else { %>
<table><thead><tr><th>Code</th><th>Description</th><th>Unit</th><th class="n">Balance</th><th class="n">Avg Cost</th><th class="n">Value</th></tr></thead><tbody>
<% stock.forEach(r => { %><tr><td><%= r.item_code %></td><td><%= r.description %></td><td><%= r.unit || '' %></td><td class="n"><%= r.current_balance %></td><td class="n"><%= Number(r.avg_cost).toFixed(2) %></td><td class="n"><%= Number(r.inventory_value).toFixed(2) %></td></tr><% }) %>
</tbody><tfoot><tr><td colspan="5">Total Stock Value</td><td class="n"><%= Number(totalValue).toFixed(2) %></td></tr></tfoot></table>
<% } %>
</body></html>
