<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'Site ERP' %> | <%= typeof appName !== 'undefined' ? appName : 'Site ERP' %></title>
  <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet">
</head>
<body>
<% var _user = (typeof currentUser !== 'undefined') ? currentUser : null; %>
<% if (_user) { %><%- include('../partials/nav') %><% } %>
<main class="container-fluid px-4 py-4">
  <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success alert-dismissible fade show"><%= success %><button class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-danger alert-dismissible fade show"><%= error %><button class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <%- body %>
</main>
<script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/js/app.js"></script>
</body>
</html>
