<div class="dashboard-page">
<%
  const role = currentUser?.role || '';
  const canReceive = ['admin', 'manager', 'operator'].includes(role);
  const canManage = ['admin', 'manager'].includes(role);
  const siteRows = Array.isArray(siteSummaries) ? siteSummaries : [];
  const movements = Array.isArray(recentMovements) ? recentMovements : [];
  const transfers = Array.isArray(recentTransfers) ? recentTransfers : [];
  const movementLocation = movement => {
    const from = movement.from_site_code || movement.from_site_name;
    const to = movement.to_site_code || movement.to_site_name;
    if (from && to) return `${from} → ${to}`;
    if (to) return `Received at ${to}`;
    if (from) return `From ${from}`;
    return movement.reason || 'Inventory activity';
  };
%>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
  <div>
    <div class="dashboard-eyebrow small fw-semibold text-uppercase mb-1">Site ERP · Operations</div>
    <h1 class="h2 fw-bold mb-1">Good <%= new Date().getHours() < 12 ? 'morning' : new Date().getHours() < 18 ? 'afternoon' : 'evening' %>, <%= currentUser.full_name || currentUser.username %></h1>
    <p class="text-muted mb-0">Your inventory and site activity at a glance.</p>
  </div>
  <span class="badge rounded-pill text-bg-light border px-3 py-2 text-capitalize"><%= role %> account</span>
</div>

<!-- Keep the two direct lookup tools at the top of the dashboard. -->
<div class="row g-3 mb-4">
  <div class="col-lg-6">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body p-4">
        <h2 class="h5 mb-1">Find an item</h2>
        <p class="text-muted small mb-3">Search the item master by code, name, or description.</p>
        <form method="get" action="/items" class="d-flex gap-2">
          <input type="search" name="q" class="form-control" placeholder="e.g. OIL-20L or Engine Oil" aria-label="Search items by code or name">
          <button type="submit" class="btn btn-primary px-4">Search</button>
        </form>
      </div>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body p-4">
        <h2 class="h5 mb-1">Find a physical instance</h2>
        <p class="text-muted small mb-3">Scan a barcode or enter an instance code.</p>
        <form method="get" action="/inventory/instances/lookup" class="d-flex gap-2">
          <input type="search" name="code" class="form-control" placeholder="Scan barcode or enter instance code" aria-label="Scan or enter a barcode or instance code" autocomplete="off" autofocus required>
          <button type="submit" class="btn btn-primary px-4">Look up</button>
        </form>
      </div>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-xl-3">
    <a href="<%= role === 'admin' ? '/sites' : '/inventory/instances' %>" class="card border-0 shadow-sm h-100 text-decoration-none text-reset">
      <div class="card-body p-3 p-lg-4"><div class="text-muted small">Active sites</div><div class="display-6 fw-bold"><%= stats.sites %></div><div class="small text-primary"><%= role === 'admin' ? 'Manage sites' : 'Your assigned locations' %> <span aria-hidden="true">→</span></div></div>
    </a>
  </div>
  <div class="col-6 col-xl-3">
    <a href="/items" class="card border-0 shadow-sm h-100 text-decoration-none text-reset">
      <div class="card-body p-3 p-lg-4"><div class="text-muted small">Active item masters</div><div class="display-6 fw-bold"><%= stats.itemMasters %></div><div class="small text-primary">Browse item catalog <span aria-hidden="true">→</span></div></div>
    </a>
  </div>
  <div class="col-6 col-xl-3">
    <a href="/inventory/instances" class="card border-0 shadow-sm h-100 text-decoration-none text-reset">
      <div class="card-body p-3 p-lg-4"><div class="text-muted small">Active instances</div><div class="display-6 fw-bold"><%= stats.instances %></div><div class="small text-primary">View inventory <span aria-hidden="true">→</span></div></div>
    </a>
  </div>
  <% if (role === 'admin') { %>
    <div class="col-6 col-xl-3"><a href="/users" class="card border-0 shadow-sm h-100 text-decoration-none text-reset"><div class="card-body p-3 p-lg-4"><div class="text-muted small">Active users</div><div class="display-6 fw-bold"><%= stats.users %></div><div class="small text-primary">Manage users <span aria-hidden="true">→</span></div></div></a></div>
  <% } else { %>
    <div class="col-6 col-xl-3"><a href="/inventory/transfers" class="card border-0 shadow-sm h-100 text-decoration-none text-reset"><div class="card-body p-3 p-lg-4"><div class="text-muted small">Transfers to review</div><div class="display-6 fw-bold"><%= pendingTransferCount || 0 %></div><div class="small text-primary">Open transfer register <span aria-hidden="true">→</span></div></div></a></div>
  <% } %>
</div>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-white border-0 px-4 pt-4 pb-2">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
      <div><h2 class="h5 mb-1">Quick actions</h2><p class="text-muted small mb-0">Start common inventory tasks.</p></div>
      <a href="/inventory/instances" class="small text-decoration-none">Open inventory <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <div class="card-body px-4 pb-4">
    <div class="row g-2">
      <% if (canReceive) { %>
        <div class="col-6 col-md-4 col-xl-2"><a href="/inventory/receive" class="btn btn-primary w-100 h-100 py-3">Add Stock</a></div>
        <div class="col-6 col-md-4 col-xl-2"><a href="/goods-receipts/new" class="btn btn-outline-primary w-100 h-100 py-3">Create GRN</a></div>
        <div class="col-6 col-md-4 col-xl-2"><a href="/inventory/issues" class="btn btn-outline-primary w-100 h-100 py-3">Issue Items</a></div>
        <div class="col-6 col-md-4 col-xl-2"><a href="/inventory/transfers/new" class="btn btn-outline-primary w-100 h-100 py-3">New Transfer</a></div>
      <% } %>
      <div class="col-6 col-md-4 col-xl-2"><a href="/inventory/labels" class="btn btn-outline-secondary w-100 h-100 py-3">Print Barcodes</a></div>
      <div class="col-6 col-md-4 col-xl-2"><a href="/inventory/movements" class="btn btn-outline-secondary w-100 h-100 py-3">Movement Ledger</a></div>
      <% if (canManage) { %>
        <div class="col-6 col-md-4 col-xl-2"><a href="/inventory/adjustment" class="btn btn-outline-secondary w-100 h-100 py-3">Adjust Inventory</a></div>
        <div class="col-6 col-md-4 col-xl-2"><a href="/items/new" class="btn btn-outline-secondary w-100 h-100 py-3">Create Item</a></div>
      <% } %>
      <% if (role === 'admin') { %>
        <div class="col-6 col-md-4 col-xl-2"><a href="/sites/new" class="btn btn-outline-secondary w-100 h-100 py-3">Create Site</a></div>
      <% } %>
    </div>
  </div>
</div>

<% if (['admin', 'manager'].includes(role)) { %>
  <div class="card border-0 shadow-sm mb-4 dashboard-accent-card">
    <div class="card-header bg-white border-0 px-4 pt-4 pb-2 d-flex justify-content-between align-items-center gap-2">
      <div><h2 class="h5 mb-1">Store overview</h2><p class="text-muted small mb-0">Active inventory by assigned site.</p></div>
      <a href="/sites" class="small text-decoration-none">Sites <span aria-hidden="true">→</span></a>
    </div>
    <% if (siteRows.length) { %>
      <div class="table-responsive"><table class="table align-middle mb-0">
        <thead class="table-light"><tr><th class="ps-4">Site</th><th>Type</th><th>Item types</th><th>Active instances</th><th>Quarantined</th><th></th></tr></thead>
        <tbody><% siteRows.forEach(site => { %>
          <tr>
            <td class="ps-4"><strong class="dashboard-site-code"><%= site.code %></strong><div class="small text-muted"><%= site.name %></div></td>
            <td><span class="badge dashboard-site-type"><%= String(site.site_type || '').replaceAll('_', ' ') %></span></td>
            <td><%= Number(site.active_item_types || 0).toLocaleString() %></td>
            <td><%= Number(site.active_instances || 0).toLocaleString() %></td>
            <td><% if (Number(site.quarantined_instances || 0)) { %><span class="badge text-bg-warning"><%= site.quarantined_instances %></span><% } else { %>0<% } %></td>
            <td class="text-end pe-4"><a href="/inventory/instances" class="btn btn-sm btn-outline-secondary">View stock</a></td>
          </tr>
        <% }) %></tbody>
      </table></div>
    <% } else { %><div class="card-body text-muted">No active sites are assigned to your account.</div><% } %>
  </div>
<% } %>

<div class="row g-3">
  <div class="col-xl-7">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white border-0 px-4 pt-4 pb-2 d-flex justify-content-between align-items-center gap-2">
        <div><h2 class="h5 mb-1">Recent inventory movement</h2><p class="text-muted small mb-0">Latest activity at sites you can access.</p></div>
        <a href="/inventory/movements" class="small text-decoration-none">View ledger <span aria-hidden="true">→</span></a>
      </div>
      <% if (movements.length) { %>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0">
          <thead class="table-light"><tr><th class="ps-4">Instance / Item</th><th>Activity</th><th>Location</th><th class="text-end pe-4">Date</th></tr></thead>
          <tbody><% movements.slice(0, 6).forEach(movement => { %>
            <tr>
              <td class="ps-4"><a href="/inventory/instances/lookup?code=<%= encodeURIComponent(movement.instance_code) %>" class="fw-semibold text-decoration-none"><%= movement.instance_code %></a><div class="small text-muted"><%= movement.item_code %> · <%= movement.item_name %></div></td>
              <td><span class="badge text-bg-light border"><%= movement.movement_type.replaceAll('_', ' ') %></span><div class="small text-muted"><%= Number(movement.quantity || 0).toLocaleString() %> <%= movement.unit %></div></td>
              <td class="small"><%= movementLocation(movement) %></td>
              <td class="text-end pe-4 text-nowrap small text-muted"><%= new Date(movement.created_at).toLocaleDateString() %></td>
            </tr>
          <% }) %></tbody>
        </table></div>
      <% } else { %><div class="card-body text-muted">No recent inventory movements.</div><% } %>
    </div>
  </div>
  <div class="col-xl-5">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white border-0 px-4 pt-4 pb-2 d-flex justify-content-between align-items-center gap-2">
        <div><h2 class="h5 mb-1">Recent transfers</h2><p class="text-muted small mb-0">Transfer status across your sites.</p></div>
        <a href="/inventory/transfers" class="small text-decoration-none">Transfer register <span aria-hidden="true">→</span></a>
      </div>
      <% if (transfers.length) { %>
        <div class="list-group list-group-flush"><% transfers.slice(0, 6).forEach(transfer => { %>
          <a href="/inventory/transfers/<%= transfer.id %>" class="list-group-item list-group-item-action px-4 py-3">
            <div class="d-flex justify-content-between align-items-start gap-2"><strong><%= transfer.transfer_number %></strong><span class="badge <%= transfer.status === 'COMPLETED' ? 'text-bg-success' : transfer.status === 'IN_TRANSIT' || transfer.status === 'PARTIALLY_RECEIVED' ? 'text-bg-warning' : 'text-bg-secondary' %>"><%= transfer.status.replaceAll('_', ' ') %></span></div>
            <div class="small text-muted mt-1"><%= transfer.from_site_code %> → <%= transfer.to_site_code %></div>
            <div class="small text-muted"><%= transfer.item_count %> item line(s) · <%= new Date(transfer.created_at).toLocaleDateString() %></div>
          </a>
        <% }) %></div>
      <% } else { %><div class="card-body text-muted">No recent transfers for your sites.</div><% } %>
    </div>
  </div>
</div>
</div>
