<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-1">Dashboard</h1>
    <p class="text-muted mb-0">
      Site-ERP inventory management
    </p>
  </div>
</div>


<div class="row g-3">

  <!-- Sites -->

  <div class="col-md-6 col-xl-3">
    <div class="card shadow-sm h-100">
      <div class="card-body">

        <div class="text-muted small">
          Sites
        </div>

        <div class="metric">
          <%= stats.sites %>
        </div>

        <a href="/sites" class="btn btn-sm btn-outline-primary mt-2">
          Manage Sites
        </a>

      </div>
    </div>
  </div>


  <!-- Item Masters -->

  <div class="col-md-6 col-xl-3">
    <div class="card shadow-sm h-100">
      <div class="card-body">

        <div class="text-muted small">
          Item Masters
        </div>

        <div class="metric">
          <%= stats.itemMasters %>
        </div>

        <a href="#" class="btn btn-sm btn-outline-primary mt-2">
          Items
        </a>

      </div>
    </div>
  </div>


  <!-- Physical Instances -->

  <div class="col-md-6 col-xl-3">
    <div class="card shadow-sm h-100">
      <div class="card-body">

        <div class="text-muted small">
          Physical Instances
        </div>

        <div class="metric">
          <%= stats.instances %>
        </div>

        <a href="#" class="btn btn-sm btn-outline-primary mt-2">
          Inventory
        </a>

      </div>
    </div>
  </div>


  <!-- Active Users -->

  <div class="col-md-6 col-xl-3">
    <div class="card shadow-sm h-100">
      <div class="card-body">

        <div class="text-muted small">
          Active Users
        </div>

        <div class="metric">
          <%= stats.users %>
        </div>

        <% if (currentUser?.role === 'admin') { %>

          <a
            href="/users"
            class="btn btn-sm btn-outline-primary mt-2"
          >
            Manage Users
          </a>

        <% } %>

      </div>
    </div>
  </div>

</div>


<div class="row g-3 mt-1">

  <div class="col-lg-6">

    <div class="card shadow-sm h-100">

      <div class="card-header">
        <strong>V2 Inventory Architecture</strong>
      </div>

      <div class="card-body">

        <p class="mb-3">
          Site-ERP is currently being rebuilt around
          individually tracked physical inventory instances.
        </p>

        <div class="list-group">

          <div class="list-group-item">
            <strong>Item Master</strong>
            <div class="small text-muted">
              Defines what an item is.
            </div>
          </div>

          <div class="list-group-item">
            <strong>Item Instance</strong>
            <div class="small text-muted">
              Represents the actual physical item.
            </div>
          </div>

          <div class="list-group-item">
            <strong>Permanent Barcode</strong>
            <div class="small text-muted">
              Identifies one physical instance.
            </div>
          </div>

          <div class="list-group-item">
            <strong>Inventory Movement</strong>
            <div class="small text-muted">
              Records every inventory-affecting operation.
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>


  <div class="col-lg-6">

    <div class="card shadow-sm h-100">

      <div class="card-header">
        <strong>Quick Actions</strong>
      </div>

      <div class="card-body">

        <% if (currentUser?.role === 'admin') { %>

          <div class="d-grid gap-2">

            <a
              href="/sites/new"
              class="btn btn-primary"
            >
              Create Site
            </a>

            <a
              href="/users/new"
              class="btn btn-outline-primary"
            >
              Create User
            </a>

          </div>

        <% } else { %>

          <p class="text-muted mb-0">
            Inventory operations will appear here as
            the V2 modules are implemented.
          </p>

        <% } %>

      </div>

    </div>

  </div>

</div>