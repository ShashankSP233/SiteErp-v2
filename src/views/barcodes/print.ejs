<% const isReceiptFlow = typeof receiptFlow !== 'undefined' && receiptFlow; %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title><%= title || 'Print Barcode Labels' %></title>

  <style>
    @page {
      size: A4 landscape;
      margin: 0;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      background: #eee;
      font-family: Arial, Helvetica, sans-serif;
    }

    .print-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;

      padding: 12px;
      margin: 12px;

      background: #fff;
      border: 1px solid #ddd;
      border-radius: 6px;
    }

    .print-toolbar button {
      padding: 8px 14px;

      border: 1px solid #222;
      border-radius: 4px;

      background: #fff;
      cursor: pointer;
    }

    .print-toolbar .primary {
      background: #111;
      color: #fff;
    }

    .receipt-controls { max-width: 900px; margin: 12px auto; padding: 16px; background: #fff; border: 1px solid #ddd; border-radius: 6px; }
    .receipt-controls form { display: flex; gap: 8px; margin-top: 10px; }
    .receipt-controls input { flex: 1; min-width: 200px; padding: 9px; }
    .receipt-controls a, .receipt-controls button { padding: 8px 14px; cursor: pointer; }
    .receipt-title { margin: 0 0 6px; }
    .receipt-status { margin: 8px 0; }
    .receipt-alert { padding: 9px 12px; margin: 10px 0; border-radius: 5px; background: #eaf4ec; color: #245b31; }
    .receipt-alert.error { background: #fdecec; color: #8a2525; }


    /*
    * A4 LANDSCAPE
    *
    * Page:
    *   297mm × 210mm
    *
    * Outer margin:
    *   8mm on every side
    *
    * Available area:
    *   281mm × 194mm
    *
    * 4 columns × 4 rows
    *
    * Gap:
    *   3mm
    *
    * Label:
    *   68mm × 46.25mm
    *
    * 4 × 68mm + 3 × 3mm = 281mm
    * 4 × 46.25mm + 3 × 3mm = 194mm
    */


    .labels-container {
      width: 281mm;
      height: 194mm;

      display: grid;

      grid-template-columns:
        repeat(4, 68mm);

      grid-template-rows:
        repeat(4, 46.25mm);

      column-gap: 3mm;
      row-gap: 3mm;

      margin: 8mm auto 0;
      padding: 0;

      background: #fff;
    }


    /*
    * Individual label
    */

    .label {
      width: 68mm;
      height: 46.25mm;

      padding: 3mm;

      background: #fff;

      border: 0.25mm solid #222;
      border-radius: 2mm;

      display: flex;
      flex-direction: column;

      overflow: hidden;

      break-inside: avoid;
      page-break-inside: avoid;
    }


    /*
    * Header
    */

    .label-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;

      gap: 2mm;
    }


    .item-code {
      font-size: 9pt;
      font-weight: 700;

      line-height: 1.05;
    }


    .item-name {
      margin-top: 0.8mm;

      font-size: 6.5pt;

      line-height: 1.1;
    }


    .instance-code {
      margin-top: 1.5mm;

      font-size: 7.5pt;
      font-weight: 700;

      line-height: 1.05;

      word-break: break-word;
    }


    .site {
      margin-top: 1mm;

      font-size: 6pt;

      line-height: 1.05;
    }


    /*
    * Barcode
    *
    * Physically larger than the previous version.
    */

    .barcode-wrapper {
      width: 100%;

      margin-top: 2.5mm;

      display: flex;
      flex-direction: column;

      align-items: center;
      justify-content: center;
    }


    .barcode {
      width: 58mm;
      height: 18mm;

      display: block;
    }


    .barcode-value {
      width: 100%;

      margin-top: 0.8mm;

      text-align: center;

      font-family: monospace;

      font-size: 5.5pt;
      line-height: 1;

      white-space: nowrap;

      overflow: hidden;
      text-overflow: ellipsis;
    }


    /*
    * Footer
    */

    .label-footer {
      margin-top: auto;

      display: flex;
      justify-content: space-between;
      align-items: flex-end;

      gap: 2mm;

      font-size: 6pt;

      line-height: 1.05;

      color: #555;
    }


    .quantity {
      white-space: nowrap;
    }


    .status {
      text-align: right;

      white-space: nowrap;
    }


    /*
    * PRINT
    */

    @media print {

      html,
      body {
        width: 297mm;
        height: 210mm;

        margin: 0;
        padding: 0;

        background: #fff;
      }


      .print-toolbar {
        display: none !important;
      }

      .receipt-controls { display: none !important; }


      .labels-container {
        width: 281mm;
        height: 194mm;

        margin: 8mm 8mm 0;
        padding: 0;

        display: grid;

        grid-template-columns:
          repeat(4, 68mm);

        grid-template-rows:
          repeat(4, 46.25mm);

        column-gap: 3mm;
        row-gap: 3mm;

        background: #fff;
      }


      .label {
        width: 68mm;
        height: 46.25mm;

        padding: 3mm;

        border: 0.25mm solid #000;
        border-radius: 2mm;

        break-inside: avoid;
        page-break-inside: avoid;
      }


      .barcode {
        width: 58mm;
        height: 18mm;
      }

    }


    /*
    * Screen preview
    *
    * On smaller screens, allow horizontal scrolling
    * instead of changing the physical print dimensions.
    */

    @media screen and (max-width: 1200px) {

      .labels-container {
        margin-left: 8mm;
        margin-right: 8mm;
      }

    }

  </style>
</head>

<body>

  <div class="print-toolbar">
    <% if (isReceiptFlow) { %>
      <form method="post" action="<%= printAction %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="primary">Print Labels</button>
      </form>
    <% } else { %>
      <button type="button" class="primary" id="printLabelsButton">Print Labels</button>
    <% } %>

    <button
      type="button"
      id="closeLabelsButton"
    >
      Close
    </button>

    <div class="info">
      <%= labels.length %>
      label<%= labels.length === 1 ? '' : 's' %>
    </div>
  </div>

  <% if (isReceiptFlow) { %>
    <section class="receipt-controls" id="scanner">
      <h1 class="receipt-title"><%= batch.reference_number || `GRN ${batch.grn_number}` %> — Barcode check</h1>
      <div><%= batch.site_code %> — <%= batch.site_name %></div>
      <div class="receipt-status"><strong><%= batch.scannedCount %> / <%= batch.labelCount %> scanned</strong></div>
      <% if (success) { %><div class="receipt-alert"><%= success %></div><% } %>
      <% if (error) { %><div class="receipt-alert error"><%= error %></div><% } %>
      <% if (batch.status === 'AWAITING_SCAN' && batch.labelCount > batch.scannedCount) { %>
        <% if (batch.labels_printed_at) { %><p>Print was started. Scan each physical label to verify it.</p><% } else { %><p>Print the labels before scanning them.</p><% } %>
        <p class="small">Scan the full instance barcode printed on the label below, such as <strong><%= batch.labels.find(label => !label.scanned_at)?.instance_code || '' %></strong>. The item code alone is not a unique instance barcode.</p>
        <form method="post" action="<%= scanAction %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input id="barcode-input" name="barcode" autocomplete="off" required placeholder="Scan barcode" autofocus <%= batch.labels_printed_at ? '' : 'disabled' %>>
          <button type="submit" <%= batch.labels_printed_at ? '' : 'disabled' %>>Record Scan</button>
        </form>
      <% } else if (batch.status === 'AWAITING_SCAN') { %>
        <p>All labels have been scanned. Complete the receipt to add items to inventory.</p>
        <form method="post" action="<%= finishAction %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit"><%= finishText %></button>
        </form>
      <% } else { %>
        <p>This receipt is complete. Labels can be reprinted for reference.</p>
      <% } %>
      <p><a href="<%= backUrl %>">Back to receipt</a></p>
    </section>
  <% } %>

  <% if (!labels.length) { %>

    <div class="empty">
      No inventory instances were selected for printing.
    </div>

  <% } else { %>

    <div class="labels-container">

      <% labels.forEach(function(label) { %>

        <div class="label">

          <div>
            <div class="label-header">
              <div>
                <div class="item-code">
                  <%= label.item_code %>
                </div>

                <div class="item-name">
                  <%= label.item_name %>
                </div>
              </div>
            </div>

            <div class="instance-code">
              <%= label.instance_code %>
            </div>

            <% if (label.site_name) { %>
              <div class="site">
                Site:
                <%= label.site_name %>

                <% if (label.site_code) { %>
                  (<%= label.site_code %>)
                <% } %>
              </div>
            <% } %>
          </div>

          <div class="barcode-wrapper">

            <svg
              class="barcode"
              data-barcode="<%= label.barcode %>"
              aria-label="Barcode <%= label.barcode %>"
            ></svg>

            <div class="barcode-value">
              <%= label.barcode %>
            </div>

          </div>

          <% if (label.brand) { %><div class="site">Brand: <%= label.brand %></div><% } %>
          <% if (label.serial_number) { %><div class="site">Serial: <%= label.serial_number %></div><% } %>

          <div class="label-footer">

            <div class="quantity">
              Qty:
              <%= label.current_quantity %>
              <%= label.unit || label.item_unit || '' %>
            </div>

            <div class="status">
              <%= label.lifecycle_status || '' %>
            </div>

          </div>

        </div>

      <% }); %>

    </div>

  <% } %>

<script src="/vendor/jsbarcode/JsBarcode.all.min.js"></script>

<script
  nonce="<%= cspNonce %>"
  data-receipt-back-url="<%= isReceiptFlow ? backUrl : '' %>"
>
  const receiptBackUrl =
    document.currentScript.dataset.receiptBackUrl || null;
  document.addEventListener('DOMContentLoaded', function () {

    // Generate every barcode.
    document
      .querySelectorAll('svg[data-barcode]')
      .forEach(function (element) {
        const value = element.dataset.barcode;

        if (!value) {
          return;
        }

        JsBarcode(element, value, {
          format: 'CODE128',
          displayValue: false,

          /*
          * Keep the barcode inside the fixed
          * 58mm × 18mm label area.
          */
          width: 1.5,
          height: 68,

          margin: 0,

          /*
          * Do not add JsBarcode text.
          * Site-ERP renders the barcode value separately.
          */
          text: ''
        });
      });

    // Attach the print handler ONCE.
    const printButton =
      document.getElementById('printLabelsButton');

    if (printButton) {
      printButton.addEventListener('click', function () {
        window.print();
      });
    }

    // Attach the close handler ONCE.
    const closeButton =
      document.getElementById('closeLabelsButton');

    if (closeButton) {
      closeButton.addEventListener('click', function () {
        if (receiptBackUrl) { window.location.href = receiptBackUrl; return; }
        if (window.history.length > 1) {
          window.history.back();
        } else {
          window.location.href = '/inventory/labels';
        }
      });
    }

    const scannerInput = document.getElementById('barcode-input');
    if (scannerInput && !scannerInput.disabled) {
      const focusScanner = function () {
        scannerInput.focus({ preventScroll: true });
      };

      // The scan POST redirects back to this page with #scanner. Restore focus
      // after the browser has completed navigation to the fragment.
      window.addEventListener('load', function () {
        window.setTimeout(focusScanner, 100);
      }, { once: true });

      focusScanner();
    }
    if (new URLSearchParams(window.location.search).get('print') === '1') {
      window.addEventListener('load', function () { window.print(); });
    }

  });
</script>

</body>
</html>
