<!doctype html><html><head><meta charset="utf-8"><title>Barcode Labels</title>
<style>
  body{font-family:Arial,sans-serif;margin:10px}
  .toolbar{margin-bottom:10px} @media print{.toolbar{display:none}}
  .grid{display:flex;flex-wrap:wrap;gap:6px}
  .label{border:1px solid #999;border-radius:4px;padding:6px 8px;width:230px;box-sizing:border-box;page-break-inside:avoid;text-align:center}
  .label .desc{font-size:10px;color:#333;margin:2px 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .label .meta{font-size:9px;color:#666}
  button{padding:6px 12px;cursor:pointer}
</style></head><body>
<div class="toolbar"><button onclick="window.print()">Print / Save as PDF</button> <span style="font-size:12px;color:#666"><%= labels.length %> label(s)</span></div>
<div class="grid">
<% labels.forEach(l => { %>
  <div class="label">
    <div class="desc"><%= l.item_code %></div>
    <div data-barcode="<%= l.label_code %>" data-mw="2" data-h="38"></div>
    <div class="meta"><%= l.description %><% if (Number(l.qty) > 1) { %> · Qty <%= l.qty %><% } %><% if (l.location) { %> · <%= l.location %><% } %></div>
  </div>
<% }) %>
</div>
<script src="/js/barcode.js"></script>
</body></html>
