<%
  const isReceiptFlow = typeof receiptFlow !== 'undefined' && receiptFlow;
  const labelPages = [];
  for (let i = 0; i < labels.length; i += 16) labelPages.push(labels.slice(i, i + 16));
  const displayBarcodeCode = value => {
    const code = String(value || '').trim();
    return isReceiptFlow ? code.toUpperCase().replace(/\s+/g, '-') : code;
  };
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title><%= title || 'Print Barcode Labels' %></title>

  <style>
    @page {
      size: A4 landscape;
      margin: 0;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      background: #eee;
      font-family: Arial, Helvetica, sans-serif;
    }

    .print-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;

      padding: 12px;
      margin: 12px;

      background: #fff;
      border: 1px solid #ddd;
      border-radius: 6px;
    }

    .print-toolbar button {
      padding: 8px 14px;

      border: 1px solid #222;
      border-radius: 4px;

      background: #fff;
      cursor: pointer;
    }

    .print-toolbar .primary {
      background: #111;
      color: #fff;
    }

    .receipt-controls { max-width: 1040px; margin: 16px auto 20px; padding: 22px 24px; background: #fff; border: 1px solid #dce2e8; border-top: 4px solid #6c7d49; border-radius: 10px; box-shadow: 0 5px 18px rgba(28, 39, 52, .08); }
    .receipt-controls form { display: flex; gap: 10px; margin-top: 14px; }
    .receipt-controls input { flex: 1; min-width: 200px; padding: 11px 13px; border: 1px solid #b8c2ce; border-radius: 6px; font-size: 15px; }
    .receipt-controls input:focus { outline: 3px solid rgba(49, 96, 255, .18); border-color: #3160ff; }
    .receipt-controls a, .receipt-controls button { padding: 10px 16px; cursor: pointer; border-radius: 6px; }
    .receipt-controls form button { border: 1px solid #315cff; background: #315cff; color: #fff; font-weight: 600; }
    .receipt-title { margin: 0 0 6px; font-size: 25px; }
    .receipt-status { display: flex; align-items: center; gap: 12px; margin: 12px 0; }
    .receipt-progress { height: 8px; flex: 1; max-width: 420px; accent-color: #6c7d49; }
    .receipt-alert { padding: 10px 13px; margin: 12px 0; border-radius: 6px; background: #edf5e9; color: #315528; }
    .receipt-alert.error { background: #fdecec; color: #8a2525; }
    .receipt-label-list { display: flex; flex-wrap: wrap; gap: 7px; max-height: 210px; overflow-y: auto; margin: 14px 0; padding: 10px; border: 1px solid #e0e5ea; border-radius: 7px; background: #f8f9fb; }
    .receipt-label-chip { display: inline-flex; align-items: center; gap: 6px; padding: 6px 9px; border: 1px solid #d5dce2; border-radius: 999px; background: #fff; font-size: 12px; }
    .receipt-label-chip.scanned { border-color: #9ab387; background: #edf5e9; color: #315528; }
    .receipt-label-chip.pending { color: #52606d; }
    .receipt-label-chip .scan-check { font-weight: 700; }


    /*
    * A4 LANDSCAPE
    *
    * Page:
    *   297mm × 210mm
    *
    * Outer margin:
    *   8mm on every side
    *
    * Available area:
    *   281mm × 194mm
    *
    * 4 columns × 4 rows
    *
    * Gap:
    *   3mm
    *
    * Label:
    *   68mm × 46.25mm
    *
    * 4 × 68mm + 3 × 3mm = 281mm
    * 4 × 46.25mm + 3 × 3mm = 194mm
    */


    .labels-page {
      width: 281mm;
      height: 194mm;
      margin: 8mm auto;
      padding: 0;
      background: #fff;
      break-after: page;
      page-break-after: always;
    }

    .labels-page:last-of-type { break-after: auto; page-break-after: auto; }

    .labels-container {
      width: 281mm;
      height: 194mm;

      display: grid;

      grid-template-columns:
        repeat(4, 68mm);

      grid-template-rows:
        repeat(4, 46.25mm);

      column-gap: 3mm;
      row-gap: 3mm;

      margin: 0;
      padding: 0;

      background: #fff;
    }


    /*
    * Individual label
    */

    .label {
      width: 68mm;
      height: 46.25mm;

      padding: 3mm;

      background: #fff;

      border: 0.25mm solid #222;
      border-radius: 2mm;

      display: flex;
      flex-direction: column;

      overflow: hidden;

      break-inside: avoid;
      page-break-inside: avoid;
    }


    /*
    * Header
    */

    .label-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;

      gap: 2mm;
    }


    .item-code {
      font-size: 9pt;
      font-weight: 700;

      line-height: 1.05;
    }


    .item-name {
      margin-top: 0.8mm;

      font-size: 6.5pt;

      line-height: 1.1;
    }


    .instance-code {
      margin-top: 1.5mm;

      font-size: 7.5pt;
      font-weight: 700;

      line-height: 1.05;

      word-break: break-word;
    }


    .site {
      margin-top: 1mm;

      font-size: 6pt;

      line-height: 1.05;
    }


    /*
    * Barcode
    *
    * Physically larger than the previous version.
    */

    .barcode-wrapper {
      width: 100%;

      margin-top: 2.5mm;

      display: flex;
      flex-direction: column;

      align-items: center;
      justify-content: center;
    }


    .barcode {
      width: 58mm;
      height: 18mm;

      display: block;
    }


    .barcode-value {
      width: 100%;

      margin-top: 0.8mm;

      text-align: center;

      font-family: monospace;

      font-size: 5.5pt;
      line-height: 1;

      white-space: nowrap;

      overflow: hidden;
      text-overflow: ellipsis;
    }


    /*
    * Footer
    */

    .label-footer {
      margin-top: auto;

      display: flex;
      justify-content: space-between;
      align-items: flex-end;

      gap: 2mm;

      font-size: 6pt;

      line-height: 1.05;

      color: #555;
    }


    .quantity {
      white-space: nowrap;
    }


    .status {
      text-align: right;

      white-space: nowrap;
    }


    /*
    * PRINT
    */

    @media print {

      html,
      body {
        width: 297mm;
        min-height: 210mm;

        margin: 0;
        padding: 0;

        background: #fff;
      }


      .print-toolbar {
        display: none !important;
      }

      .receipt-controls { display: none !important; }


      .labels-page {
        width: 281mm;
        height: 194mm;
        margin: 8mm;
        padding: 0;
        break-after: page;
        page-break-after: always;
      }

      .labels-page:last-of-type { break-after: auto; page-break-after: auto; }

      .labels-container {
        width: 281mm;
        height: 194mm;
        margin: 0;
        padding: 0;

        display: grid;

        grid-template-columns:
          repeat(4, 68mm);

        grid-template-rows:
          repeat(4, 46.25mm);

        column-gap: 3mm;
        row-gap: 3mm;

        background: #fff;
      }


      .label {
        width: 68mm;
        height: 46.25mm;

        padding: 3mm;

        border: 0.25mm solid #000;
        border-radius: 2mm;

        break-inside: avoid;
        page-break-inside: avoid;
      }


      .barcode {
        width: 58mm;
        height: 18mm;
      }

    }


    /*
    * Screen preview
    *
    * On smaller screens, allow horizontal scrolling
    * instead of changing the physical print dimensions.
    */

    @media screen and (max-width: 1200px) {

      .labels-page {
        margin-left: 8mm;
        margin-right: 8mm;
      }

    }

  </style>
</head>

<body>

  <div class="print-toolbar">
    <% if (isReceiptFlow) { %>
      <form method="post" action="<%= printAction %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="primary">Print Labels</button>
      </form>
    <% } else { %>
      <button type="button" class="primary" id="printLabelsButton">Print Labels</button>
    <% } %>

    <button
      type="button"
      id="closeLabelsButton"
    >
      Close
    </button>

    <div class="info">
      <%= labels.length %>
      label<%= labels.length === 1 ? '' : 's' %>
    </div>
  </div>

  <% if (isReceiptFlow) { %>
    <section class="receipt-controls" id="scanner">
      <h1 class="receipt-title"><%= batch.reference_number || `GRN ${batch.grn_number}` %> — Barcode check</h1>
      <div><%= batch.site_code %> — <%= batch.site_name %></div>
      <div class="receipt-status">
        <strong><%= batch.scannedCount %> / <%= batch.labelCount %> scanned</strong>
        <progress class="receipt-progress" value="<%= batch.scannedCount %>" max="<%= batch.labelCount || 1 %>" aria-label="Barcode scan progress"></progress>
      </div>
      <% if (success) { %><div class="receipt-alert"><%= success %></div><% } %>
      <% if (error) { %><div class="receipt-alert error"><%= error %></div><% } %>
      <% if (batch.status === 'AWAITING_SCAN' && batch.labelCount > batch.scannedCount) { %>
        <% if (batch.labels_printed_at) { %><p>Print was started. Scan each physical label to verify it.</p><% } else { %><p>Print the labels before scanning them.</p><% } %>
        <p class="small">Scan the full instance barcode printed on the label below, such as <strong><%= displayBarcodeCode(batch.labels.find(label => !label.scanned_at)?.instance_code) %></strong>. The item code alone is not a unique instance barcode.</p>
        <form method="post" action="<%= scanAction %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input id="barcode-input" name="barcode" autocomplete="off" required placeholder="Scan barcode" autofocus <%= batch.labels_printed_at ? '' : 'disabled' %>>
          <button type="submit" <%= batch.labels_printed_at ? '' : 'disabled' %>>Record Scan</button>
        </form>
      <% } else if (batch.status === 'AWAITING_SCAN') { %>
        <p>All labels have been scanned. Complete the receipt to add items to inventory.</p>
        <form method="post" action="<%= finishAction %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit"><%= finishText %></button>
        </form>
      <% } else { %>
        <p>This receipt is complete. Labels can be reprinted for reference.</p>
      <% } %>
      <div class="receipt-label-list" aria-label="Barcode scan checklist">
        <% batch.labels.forEach(label => { %>
          <div class="receipt-label-chip <%= label.scanned_at ? 'scanned' : 'pending' %>" title="<%= label.item_name %>">
            <span class="scan-check"><%= label.scanned_at ? '✓' : '○' %></span>
            <span><%= displayBarcodeCode(label.instance_code) %></span>
            <span><%= label.scanned_at ? 'Scanned' : 'Pending' %></span>
          </div>
        <% }) %>
      </div>
      <p><a href="<%= backUrl %>">Back to receipt</a></p>
    </section>
  <% } %>

  <% if (!labels.length) { %>

    <div class="empty">
      No inventory instances were selected for printing.
    </div>

  <% } else { %>

    <% labelPages.forEach(function(pageLabels) { %>
    <div class="labels-page"><div class="labels-container">

      <% pageLabels.forEach(function(label) { %>

        <div class="label">

          <div>
            <div class="label-header">
              <div>
                <div class="item-code">
                  <%= displayBarcodeCode(label.item_code) %>
                </div>

                <div class="item-name">
                  <%= label.item_name %>
                </div>
              </div>
            </div>

            <div class="instance-code">
              <%= displayBarcodeCode(label.instance_code) %>
            </div>

            <% if (label.site_name) { %>
              <div class="site">
                Site:
                <%= label.site_name %>

                <% if (label.site_code) { %>
                  (<%= label.site_code %>)
                <% } %>
              </div>
            <% } %>
          </div>

          <div class="barcode-wrapper">

            <svg
              class="barcode"
              data-barcode="<%= displayBarcodeCode(label.barcode) %>"
              aria-label="Barcode <%= displayBarcodeCode(label.barcode) %>"
            ></svg>

            <div class="barcode-value">
              <%= displayBarcodeCode(label.barcode) %>
            </div>

          </div>

          <% if (label.brand) { %><div class="site">Brand: <%= label.brand %></div><% } %>
          <% if (label.serial_number) { %><div class="site">Serial: <%= label.serial_number %></div><% } %>

          <div class="label-footer">

            <div class="quantity">
              Qty:
              <%= label.current_quantity %>
              <%= label.unit || label.item_unit || '' %>
            </div>

            <div class="status">
              <%= label.lifecycle_status || '' %>
            </div>

          </div>

        </div>

      <% }); %>

    </div></div>
    <% }); %>

  <% } %>

<script src="/vendor/jsbarcode/JsBarcode.all.min.js"></script>

<script
  nonce="<%= cspNonce %>"
  data-receipt-back-url="<%= isReceiptFlow ? backUrl : '' %>"
>
  const receiptBackUrl =
    document.currentScript.dataset.receiptBackUrl || null;
  document.addEventListener('DOMContentLoaded', function () {

    // Generate every barcode.
    document
      .querySelectorAll('svg[data-barcode]')
      .forEach(function (element) {
        const value = element.dataset.barcode;

        if (!value) {
          return;
        }

        JsBarcode(element, value, {
          format: 'CODE128',
          displayValue: false,

          /*
          * Keep the barcode inside the fixed
          * 58mm × 18mm label area.
          */
          width: 1.5,
          height: 68,

          margin: 0,

          /*
          * Do not add JsBarcode text.
          * Site-ERP renders the barcode value separately.
          */
          text: ''
        });
      });

    // Attach the print handler ONCE.
    const printButton =
      document.getElementById('printLabelsButton');

    if (printButton) {
      printButton.addEventListener('click', function () {
        window.print();
      });
    }

    // Attach the close handler ONCE.
    const closeButton =
      document.getElementById('closeLabelsButton');

    if (closeButton) {
      closeButton.addEventListener('click', function () {
        if (receiptBackUrl) { window.location.href = receiptBackUrl; return; }
        if (window.history.length > 1) {
          window.history.back();
        } else {
          window.location.href = '/inventory/labels';
        }
      });
    }

    const scannerInput = document.getElementById('barcode-input');
    if (scannerInput && !scannerInput.disabled) {
      const focusScanner = function () {
        scannerInput.focus({ preventScroll: true });
      };

      // The scan POST redirects back to this page with #scanner. Restore focus
      // after the browser has completed navigation to the fragment.
      window.addEventListener('load', function () {
        window.setTimeout(focusScanner, 100);
      }, { once: true });

      focusScanner();
    }
    if (new URLSearchParams(window.location.search).get('print') === '1') {
      window.addEventListener('load', function () { window.print(); });
    }

  });
</script>

</body>
</html>
