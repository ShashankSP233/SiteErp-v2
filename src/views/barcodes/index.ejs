<div class="page-header">
  <div>
    <h1>Barcode Labels</h1>
    <p class="muted">
      Print permanent barcode labels for inventory instances.
    </p>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div>
      <h2>Inventory Instances</h2>
      <p class="muted">
        Select one or more inventory instances to print their existing barcodes.
      </p>
    </div>
  </div>

  <form method="GET" action="/inventory/labels" class="filter-form">
    <label class="checkbox-label">
      <input
        type="checkbox"
        name="active"
        value="1"
        <%= activeOnly ? 'checked' : '' %>
        onchange="this.form.submit()"
      >
      Show active instances only
    </label>

    <button type="submit" class="btn btn-secondary">
      Apply Filter
    </button>

    <% if (activeOnly) { %>
      <a href="/inventory/labels" class="btn btn-secondary">
        Clear Filter
      </a>
    <% } %>
  </form>
</div>

<form method="POST" action="/inventory/labels/print" id="barcode-print-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="card">
    <div class="card-header">
      <div>
        <h2>Available Labels</h2>
        <p class="muted">
          <%= labels.length %> inventory instance<%= labels.length === 1 ? '' : 's' %> found.
        </p>
      </div>

      <div class="button-group">
        <button
          type="button"
          class="btn btn-secondary"
          id="selectAllButton"
        >
          Select All
        </button>

        <button
          type="button"
          class="btn btn-secondary"
          id="clearSelectionButton"
        >
          Clear Selection
        </button>

        <button
          type="submit"
          class="btn btn-primary"
          id="print-selected-button"
        >
          Print Selected
        </button>
      </div>
    </div>

    <% if (!labels.length) { %>

      <div class="empty-state">
        <h3>No inventory instances found</h3>
        <p>
          There are currently no inventory instances available for barcode
          printing with the selected filter.
        </p>
      </div>

    <% } else { %>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width: 45px;">
                <input
                  type="checkbox"
                  id="select-all"
                  title="Select all"
                >
              </th>
              <th>Instance Code</th>
              <th>Barcode</th>
              <th>Item</th>
              <th>Site</th>
              <th>Current Quantity</th>
              <th>Status</th>
              <th style="width: 100px;">Action</th>
            </tr>
          </thead>

          <tbody>
            <% labels.forEach(function(label) { %>
              <tr>
                <td>
                  <input
                    type="checkbox"
                    class="label-checkbox"
                    name="instanceIds"
                    value="<%= label.instance_id %>"
                    onchange="updateSelectAllState()"
                  >
                </td>

                <td>
                  <strong>
                    <%= label.instance_code %>
                  </strong>
                </td>

                <td>
                  <code>
                    <%= label.barcode %>
                  </code>
                </td>

                <td>
                  <div>
                    <strong>
                      <%= label.item_code %>
                    </strong>
                  </div>

                  <div class="muted">
                    <%= label.item_name %>
                  </div>
                </td>

                <td>
                  <% if (label.site_name) { %>
                    <%= label.site_name %>
                    <% if (label.site_code) { %>
                      <div class="muted">
                        <%= label.site_code %>
                      </div>
                    <% } %>
                  <% } else { %>
                    <span class="muted">No site</span>
                  <% } %>
                </td>

                <td>
                  <%= label.current_quantity %>
                  <%= label.unit || label.item_unit || '' %>
                </td>

                <td>
                  <span class="status-badge status-<%= String(label.lifecycle_status || '').toLowerCase() %>">
                    <%= label.lifecycle_status || 'UNKNOWN' %>
                  </span>
                </td>

                <td>
                  <a
                    href="/inventory/labels/print/<%= label.instance_id %>"
                    class="btn btn-sm btn-secondary"
                    target="_blank"
                  >
                    Print
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

    <% } %>
  </div>
</form>

<script nonce="<%= cspNonce %>">
  document.addEventListener('DOMContentLoaded', function () {

    function getLabelCheckboxes() {
      return Array.from(
        document.querySelectorAll('.label-checkbox')
      );
    }

    function toggleAllLabels(checked) {
      getLabelCheckboxes().forEach(function (checkbox) {
        checkbox.checked = checked;
      });

      updateSelectAllState();
    }

    function updateSelectAllState() {
      const checkboxes = getLabelCheckboxes();
      const selectAll =
        document.getElementById('select-all');

      if (!selectAll) {
        return;
      }

      if (!checkboxes.length) {
        selectAll.checked = false;
        selectAll.indeterminate = false;
        return;
      }

      const checkedCount =
        checkboxes.filter(function (checkbox) {
          return checkbox.checked;
        }).length;

      selectAll.checked =
        checkedCount === checkboxes.length;

      selectAll.indeterminate =
        checkedCount > 0 &&
        checkedCount < checkboxes.length;
    }

    // Header checkbox
    const selectAll =
      document.getElementById('select-all');

    if (selectAll) {
      selectAll.addEventListener(
        'change',
        function () {
          toggleAllLabels(selectAll.checked);
        }
      );
    }

    // Select All button
    const selectAllButton =
      document.getElementById('selectAllButton');

    if (selectAllButton) {
      selectAllButton.addEventListener(
        'click',
        function () {
          toggleAllLabels(true);
        }
      );
    }

    // Clear Selection button
    const clearSelectionButton =
      document.getElementById('clearSelectionButton');

    if (clearSelectionButton) {
      clearSelectionButton.addEventListener(
        'click',
        function () {
          toggleAllLabels(false);
        }
      );
    }

    // Individual checkboxes
    getLabelCheckboxes().forEach(
      function (checkbox) {
        checkbox.addEventListener(
          'change',
          updateSelectAllState
        );
      }
    );

    // Prevent printing with nothing selected.
    const printForm =
      document.getElementById('barcode-print-form');

    if (printForm) {
      printForm.addEventListener(
        'submit',
        function (event) {
          const selected =
            getLabelCheckboxes().filter(
              function (checkbox) {
                return checkbox.checked;
              }
            );

          if (!selected.length) {
            event.preventDefault();

            alert(
              'Please select at least one inventory instance to print.'
            );
          }
        }
      );
    }

    updateSelectAllState();
  });
</script>