<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
  <div>
    <h1 class="h3 fw-bold mb-1">Barcode Labels</h1>
    <p class="text-muted mb-0">
      Select inventory instances and print their permanent barcode labels.
    </p>
  </div>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-header bg-white py-3">
    <h2 class="h5 mb-1">Filter Inventory</h2>
    <p class="text-muted small mb-0">
      Narrow the list to active instances if needed.
    </p>
  </div>

  <div class="card-body">
    <form method="get" action="/inventory/labels"
          class="d-flex flex-column flex-sm-row align-items-sm-center gap-3">
      <input type="hidden" name="itemMasterId" value="<%= itemMasterId || '' %>">

      <div class="form-check">
        <input
          id="active-only"
          type="checkbox"
          name="active"
          value="1"
          class="form-check-input"
          <%= activeOnly ? 'checked' : '' %>
        >
        <label for="active-only" class="form-check-label">
          Show active instances only
        </label>
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Apply Filter</button>

        <% if (activeOnly) { %>
          <a
            href="/inventory/labels<%= itemMasterId ? `?itemMasterId=${encodeURIComponent(itemMasterId)}` : '' %>"
            class="btn btn-outline-secondary"
          >
            Clear
          </a>
        <% } %>
      </div>
    </form>
  </div>
</div>

<form method="post" action="/inventory/labels/print" id="barcode-print-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="card shadow-sm">
    <div class="card-header bg-white py-3">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
          <h2 class="h5 mb-1">Available Labels</h2>
          <p class="text-muted small mb-0">
            <%= labels.length %> inventory instance<%= labels.length === 1 ? '' : 's' %> found.
          </p>
        </div>

        <% if (['admin', 'manager', 'operator'].includes(currentUser.role)) { %>
          <div class="d-flex flex-wrap gap-2">
            <button
              type="button"
              class="btn btn-outline-secondary btn-sm"
              id="selectAllButton"
            >
              Select All
            </button>

            <button
              type="button"
              class="btn btn-outline-secondary btn-sm"
              id="clearSelectionButton"
            >
              Clear Selection
            </button>

            <button
              type="submit"
              class="btn btn-primary btn-sm"
              id="print-selected-button"
            >
              Print Selected
            </button>
          </div>
        <% } %>
      </div>
    </div>

    <% if (!labels.length) { %>
      <div class="card-body text-center py-5">
        <h3 class="h5">No inventory instances found</h3>
        <p class="text-muted mb-0">
          There are no instances available for barcode printing with this filter.
        </p>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover table-striped align-middle mb-0 data-table">
          <thead class="table-light">
            <tr>
              <% if (['admin', 'manager', 'operator'].includes(currentUser.role)) { %>
                <th class="text-center" style="width: 48px;">
                  <input
                    type="checkbox"
                    id="select-all"
                    class="form-check-input"
                    title="Select all instances"
                    aria-label="Select all instances"
                  >
                </th>
              <% } %>
              <th class="text-nowrap">Instance Code</th>
              <th class="text-nowrap">Barcode</th>
              <th>Item</th>
              <th>Current Location</th>
              <th class="text-nowrap text-end">Current Quantity</th>
              <th>Status</th>
              <th class="text-end">Action</th>
            </tr>
          </thead>

          <tbody>
            <% labels.forEach(function(label) { %>
              <% const status = String(label.lifecycle_status || '').toUpperCase(); %>
              <% const statusClass =
                status === 'ACTIVE' ? 'text-bg-primary' :
                status === 'IN_TRANSIT' ? 'text-bg-warning' :
                status === 'CONSUMED' ? 'text-bg-secondary' :
                ['MIA', 'LOST', 'DISPOSED'].includes(status) ? 'text-bg-danger' :
                'text-bg-light'; %>

              <tr>
                <% if (['admin', 'manager', 'operator'].includes(currentUser.role)) { %>
                  <td class="text-center">
                    <input
                      type="checkbox"
                      class="form-check-input label-checkbox"
                      name="instanceIds"
                      value="<%= label.instance_id %>"
                      aria-label="Select <%= label.instance_code %>"
                    >
                  </td>
                <% } %>

                <td class="text-nowrap">
                  <strong><%= label.instance_code %></strong>
                </td>

                <td class="text-nowrap">
                  <code><%= label.barcode || '—' %></code>
                </td>

                <td>
                  <strong class="d-block"><%= label.item_code %></strong>
                  <span class="small text-muted"><%= label.item_name %></span>
                </td>

                <td>
                  <% if (label.site_name) { %>
                    <strong><%= label.site_name %></strong>
                    <% if (label.site_code) { %>
                      <span class="d-block small text-muted"><%= label.site_code %></span>
                    <% } %>
                  <% } else { %>
                    <span class="text-muted">No site assigned</span>
                  <% } %>
                </td>

                <td class="text-nowrap text-end">
                  <%= Number(label.current_quantity || 0).toLocaleString() %>
                  <%= label.unit || label.item_unit || '' %>
                </td>

                <td>
                  <span class="badge <%= statusClass %>">
                    <%= status || 'UNKNOWN' %>
                  </span>
                </td>

                <td class="text-end">
                  <a
                    href="/inventory/labels/print/<%= label.instance_id %>"
                    class="btn btn-sm btn-outline-primary"
                    target="_blank"
                    rel="noopener"
                  >
                    Print
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</form>

<script nonce="<%= cspNonce %>">
  document.addEventListener('DOMContentLoaded', function () {
    const checkboxes = Array.from(
      document.querySelectorAll('.label-checkbox')
    );
    const selectAll = document.getElementById('select-all');
    const printForm = document.getElementById('barcode-print-form');

    function updateSelectAllState() {
      if (!selectAll) return;

      const checkedCount = checkboxes.filter(box => box.checked).length;
      selectAll.checked = checkboxes.length > 0 &&
        checkedCount === checkboxes.length;
      selectAll.indeterminate = checkedCount > 0 &&
        checkedCount < checkboxes.length;
    }

    function setAll(checked) {
      checkboxes.forEach(box => {
        box.checked = checked;
      });
      updateSelectAllState();
    }

    if (selectAll) {
      selectAll.addEventListener('change', () => setAll(selectAll.checked));
    }

    document.getElementById('selectAllButton')?.addEventListener(
      'click',
      () => setAll(true)
    );

    document.getElementById('clearSelectionButton')?.addEventListener(
      'click',
      () => setAll(false)
    );

    checkboxes.forEach(box => {
      box.addEventListener('change', updateSelectAllState);
    });

    printForm?.addEventListener('submit', function (event) {
      if (!checkboxes.some(box => box.checked)) {
        event.preventDefault();
        alert('Please select at least one inventory instance to print.');
      }
    });

    updateSelectAllState();
  });
</script>